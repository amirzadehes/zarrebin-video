{"sentences": [{"i": 0, "t0": 0, "t1": 4.66, "text": "معتبرترین جایزه‌ی آشپزی دنیا یا همون ستاره‌های میشلین از کجا میاد؟"}, {"i": 1, "t0": 7.26, "t1": 10.66, "text": "یه شرکت لاستیک از کجا می‌فهمه کدوم غذا بهترینه؟"}, {"i": 2, "t0": 11.46, "t1": 14.36, "text": "برگردیم به سال ۱۹۰۰."}, {"i": 3, "t0": 14.24, "t1": 17.52, "text": "اون موقع کل فرانسه کمتر از ۳ هزار تا ماشین داشت."}, {"i": 4, "t0": 17.98, "t1": 26.66, "text": "برادرهای میشلین لاستیک می‌ساختن، ولی یه مشکل داشتن: لاستیک فقط وقتی از بین می‌ره که ماشین راه بره."}, {"i": 5, "t0": 26.54, "t1": 28.2, "text": "پس یه فکر عجیب کردن."}, {"i": 6, "t0": 30.68, "t1": 37.66, "text": "یه کتاب راهنمای مجانی دادن دست راننده‌ها: نقشه، پمپ بنزین، تعمیرگاه، هتل و رستوران."}, {"i": 7, "t0": 38.1, "t1": 44.64, "text": "هدف ساده بود: مردم بیشتر سفر کنن، لاستیکشون زودتر از بین بره و لاستیک نو بخرن."}, {"i": 8, "t0": 45.88, "t1": 50.7, "text": "سال ۱۹۲۶ میشلین به بهترین رستوران‌های کتاب ستاره داد."}, {"i": 9, "t0": 50.58, "t1": 53.1, "text": "حالا معنی ستاره‌ها رو ببین:"}, {"i": 10, "t0": 53.8, "t1": 57.92, "text": "یک ستاره یعنی یه رستوران خیلی خوب که می‌صرفه برای غذا اونجا وایسی"}, {"i": 11, "t0": 57.8, "t1": 61.82, "text": "دو ستاره یعنی ارزش داره مسیرتو براش کج کنی."}, {"i": 12, "t0": 62.5, "t1": 67.22, "text": "سه ستاره یعنی ارزش داره فقط به خاطرش سفر کنی."}, {"i": 13, "t0": 67.86, "t1": 68.52, "text": "دیدی؟"}, {"i": 14, "t0": 68.4, "t1": 71.24, "text": "ستاره‌ها با کیلومتر اندازه گرفته می‌شن."}, {"i": 15, "t0": 71.04, "t1": 74.04, "text": "هر ستاره‌ی بیشتر یعنی رانندگی بیشتر."}, {"i": 16, "t0": 73.62, "t1": 76.52, "text": "یعنی همون فروش لاستیک بیشتر"}, {"i": 17, "t0": 76.4, "t1": 79.12, "text": "ولی هیچ رستورانی نمی‌تونه این ستاره رو بخره."}, {"i": 18, "t0": 79.66, "t1": 82.56, "text": "بازرس‌های میشلین ناشناسن."}, {"i": 19, "t0": 82.96, "t1": 89.52, "text": "با اسم جعلی میز رزرو می‌کنن، مثل یه مشتری معمولی غذا می‌خورن و صورت‌حسابو خودشون می‌دن."}, {"i": 20, "t0": 89.88, "t1": 93.04, "text": "سرآشپز هیچ‌وقت نمی‌دونه کدوم مشتری بازرسه."}, {"i": 21, "t0": 92.84, "t1": 97.76, "text": "پس هر بشقابی که از آشپزخونه بیرون می‌ره، باید عالی باشه."}, {"i": 22, "t0": 98.2, "t1": 101.14, "text": "واسه همین این ستاره‌ها این‌قدر کمیابن."}, {"i": 23, "t0": 101.64, "t1": 106.2, "text": "امروز تو کل دنیا فقط حدود ۱۵۰ رستوران سه ستاره دارن."}, {"i": 24, "t0": 106.58, "t1": 117.54, "text": "پس دفعه‌ی بعد که اسم یه رستوران ستاره‌دار رو شنیدی، یادت باشه: معتبرترین جایزه‌ی آشپزی دنیا، از یه ترفند فروش لاستیک شروع شد."}, {"i": 25, "t0": 117.42, "t1": 122.06, "text": "کامل ترش تو یوتیوب هست، اونجا میتونی بیشتر از میشلین بدونی"}, {"i": 26, "t0": 121.94, "t1": 124.7, "text": "ذره‌بین دست شماست؛ بگین بعدی رو کجا بذاریم؟"}], "words": [{"w": "معتبرترین", "t0": 0.04, "t1": 0.72, "s": 0}, {"w": "جایزه‌ی", "t0": 1.0, "t1": 1.46, "s": 0}, {"w": "آشپزی", "t0": 1.54, "t1": 2.08, "s": 0}, {"w": "دنیا", "t0": 2.08, "t1": 2.56, "s": 0}, {"w": "یا", "t0": 2.72, "t1": 3.0, "s": 0}, {"w": "همون", "t0": 3.0, "t1": 3.243, "s": 0}, {"w": "ستاره‌های", "t0": 3.243, "t1": 3.68, "s": 0}, {"w": "میشلین", "t0": 3.68, "t1": 4.02, "s": 0}, {"w": "از", "t0": 4.02, "t1": 4.38, "s": 0}, {"w": "کجا", "t0": 4.38, "t1": 4.43, "s": 0}, {"w": "میاد؟", "t0": 4.38, "t1": 4.66, "s": 0}, {"w": "یه", "t0": 7.38, "t1": 7.62, "s": 1}, {"w": "شرکت", "t0": 7.62, "t1": 7.94, "s": 1}, {"w": "لاستیک", "t0": 7.94, "t1": 8.48, "s": 1}, {"w": "از", "t0": 8.48, "t1": 8.68, "s": 1}, {"w": "کجا", "t0": 8.68, "t1": 9.06, "s": 1}, {"w": "می‌فهمه", "t0": 9.06, "t1": 9.4, "s": 1}, {"w": "کدوم", "t0": 9.4, "t1": 9.74, "s": 1}, {"w": "غذا", "t0": 9.74, "t1": 10.02, "s": 1}, {"w": "بهترینه؟", "t0": 10.02, "t1": 10.66, "s": 1}, {"w": "برگردیم", "t0": 11.58, "t1": 12.28, "s": 2}, {"w": "به", "t0": 12.28, "t1": 12.46, "s": 2}, {"w": "سال", "t0": 12.46, "t1": 12.64, "s": 2}, {"w": "۱۹۰۰.", "t0": 12.64, "t1": 14.36, "s": 2}, {"w": "اون", "t0": 14.36, "t1": 14.56, "s": 3}, {"w": "موقع", "t0": 14.56, "t1": 14.74, "s": 3}, {"w": "کل", "t0": 14.74, "t1": 15.22, "s": 3}, {"w"