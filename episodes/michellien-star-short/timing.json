{"sentences": [{"i": 0, "t0": 0, "t1": 5.52, "text": "می‌دونستی معتبرترین جایزه‌ی آشپزی دنیا رو یه کارخونه‌ی لاستیک‌سازی سازی می‌ده؟"}, {"i": 1, "t0": 5.52, "t1": 6.52, "text": "همون میشلین."}, {"i": 2, "t0": 6.4, "t1": 9.6, "text": "همون آدمک سفید و چاقی که از لاستیک ساخته شده."}, {"i": 3, "t0": 10.26, "t1": 14.2, "text": "یه شرکت لاستیک از کجا می‌فهمه کدوم غذا بهترینه؟"}, {"i": 4, "t0": 13.76, "t1": 16.58, "text": "اصلاً چرا باید براش مهم باشه؟"}, {"i": 5, "t0": 16.34, "t1": 18.76, "text": "بذار برگردیم به سال 1900."}, {"i": 6, "t0": 19.3, "t1": 23.2, "text": "اون موقع کل فرانسه کمتر از سه هزار تا ماشین داشت."}, {"i": 7, "t0": 23.18, "t1": 26.32, "text": "دو تا برادر، آندره و ادوار میشلین، لاستیک می‌ساختن."}, {"i": 8, "t0": 26.22, "t1": 28.16, "text": "یه مشکل بزرگ داشتن."}, {"i": 9, "t0": 28.64, "t1": 31.96, "text": "لاستیک فقط وقتی خریده میشه که ماشین راه بره."}, {"i": 10, "t0": 31.78, "t1": 35.34, "text": "ماشینی که تو پارکینگ وای وایساده، هیچ هیچ‌وقت لاستیک نو نمی‌خواد."}, {"i": 11, "t0": 35.74, "t1": 40.24, "text": "پس اومدن یه فکر خفن کردن مردمو بکشونیم تو جاده."}, {"i": 12, "t0": 40.04, "t1": 45.72, "text": "یه کتابچه‌ی کوچیک چاپ کردن و حدود 35 هزار نسخه‌شو مجانی دادن به راننده‌ها."}, {"i": 13, "t0": 45.6, "t1": 52.76, "text": "ها توش نقشه، آموزش شعب از کردن لاستیک، آدرس پمپ بنزین، تعمیرگاه، هتل و رستوران."}, {"i": 14, "t0": 53.02, "t1": 55.74, "text": "بذار مثال بزنم تا دقیقاً متوجه بشی اینا چی کار کردن."}, {"i": 15, "t0": 55.62, "t1": 61.98, "text": "فرض کن یه شرکت کفش به به‌جای تبلیغ کفش، مجانی بهت نقشه‌ی بهترین مسیرهای کوهنوردی رو بده."}, {"i": 16, "t0": 61.8, "t1": 66.56, "text": "تو بیشتر راه می‌ری، کفشت زودتر پاره می‌شه، و مجبوری که دوباره کفش بخری"}, {"i": 17, "t0": 67.18, "t1": 72.74, "text": "راه راهنمای میشلین دقیقاً همین بود یه تبلیغ زیرپوستی که شکل کتاب راه راهنما داشت."}, {"i": 18, "t0": 73.34, "t1": 75.61, "text": "بیست سال همین همین‌جوری کتاب رو مجانی می میدادن."}, {"i": 19, "t0": 75.43, "t1": 83.23, "text": "تا اینکه که یه روز، آندره رفت لاستیک لاستیک‌فروشی و دید اه کتاب‌هاشو گذاشتن زیر پایه‌ی این میز کار که لق نزنه!"}, {"i": 20, "t0": 83.67, "t1": 85.11, "text": "اینو خوده آندره تعریف کرده"}, {"i": 21, "t0": 85.01, "t1": 89.15, "text": "از سال 1920 کتاب پولی شد هفت فرانک."}, {"i": 22, "t0": 88.79, "t1": 92.99, "text": "منطقش هم ساده بود آدم فقط به چیزی احترام می می‌ذاره که براش پول داده."}, {"i": 23, "t0": 93.87, "t1": 96.51, "text": "خب، حالا ببینیم این ستاره‌ها ها از کجا اومدن؟"}, {"i": 24, "t0": 97.49, "t1": 106.87, "text": "سال 1926 میشلین شروع کرد به بهترین رستوران‌ها ها یه ستاره داد و سال 1931 شد سه ست یک، دو و سه ستاره."}, {"i": 25, "t0": 107.53, "t1": 111.19, "text": "حالا سب کن، الان می‌فهمی چرا این ستاره‌ها ها هنوز بوی جاده می‌دن."}, {"i": 26, "t0": 112.13, "t1": 114.87, "text": "یک ستاره یعنی یه رستوران خیلی خوب تو دسته‌ی خودش."}, {"i": 27, "t0": 115.29, "t1": 118.91, "text": "دو ستاره یعنی آشپزی عالی، ارزش داره مسیرتو کج کنی."}, {"i": 28, "t0": 119.41, "t1": 124.97, "text": "سه ستاره یعنی آشپزی استثنایی، ارزش داره فقط به خاطر همین رستوران سفر کنی."}, {"i": 29, "t0": 124.91, "t1": 126.35, "text": "دیدی؟"}, {"i": 30, "t0": 126.23, "t1": 128.79, "text": "ستاره‌ها ها با کیلومتر اندازه گرفته می‌شن."}, {"i": 31, "t0": 128.59, "t1": 132.21, "text": "هر ستاره‌ی بیشتر یعنی بیشتر رانندگی کن تا بهش برسی."}, {"i": 32, "t0": 132.07, "t1": 134.93, "text": "همون هدف اول لاستیک زودتر تموم بشه."}, {"i": 33, "t0": 134.59, "t1": 141.03, "text": "پس ستاره‌ی میشلین در جواب این سؤاله «این غذا ارزش چقدر رانندگی رو داره؟»"}, {"i": 34, "t0": 141.35, "t1": 143.05, "text": "حالا کی این ستاره‌ها ها رو می‌ده؟"}, {"i": 35, "t0": 143.29, "t1": 146.89, "text": "میشلین از 1933 بازرس‌های مخصوص خودشو رو داره."}, {"i": 36, "t0": 146.59, "t1": 149.29, "text": "و این بازرس‌ها ناشناسن."}, {"i": 37, "t0": 149.03, "t1": 154.88, "text": "با اسم جعلی میز رزرو می‌کنن، مثل این مشتری معمولی قضا می می‌خورن و پول قضا رو خودشون می می‌دن."}, {"i": 38, "t0": 154.96, "t1": 158.88, "text": "هر کدوم سالی بیشتر از دیویست و پنجیاه بار بیرون غذا می می‌خورن."}, {"i": 39, "t0": 158.98, "t1": 161.8, "text": "بهشون توصیه می می‌شه حتی به پدر و مادرشون نگن که چی"}, {"i": 40, "t0": 161.68, "t1": 164.26, "text": "فکر کن تو سرآشپزی."}, {"i": 41, "t0": 164.72, "t1": 169.16, "text": "هر شب ممکنه یکی از آدمای های سر میز بازرس باشه و تو نمی نمی‌دونی کدومه."}, {"i": 42, "t0": 169.64, "t1": 174.06, "text": "واسه همین هر بشقاب باید عالی باشه، نه فقط شبی مهمون و مهم داری."}, {"i": 43, "t0": 175.1, "t1": 176.9, "text": "این ستاره چقدر کمیابه؟"}, {"i": 44, "t0": 176.66, "t1": 185.56, "text": "تو کل دنیا حدود 3000 رستوران یه ستاره دارن، حدود 500 تا 2 ستاره، و فقط حدود 150 تا 3 ستاره."}, {"i": 45, "t0": 186.38, "t1": 190.7, "text": "خب، نکنه ستاره فقط مال رستوران‌های گرون با رومیزی سفید و قاشق نقره‌ایه؟"}, {"i": 46, "t0": 191.62, "t1": 192.1, "text": "نه."}, {"i": 47, "t0": 191.68, "t1": 197.36, "text": "سال 2016 میشلین به یه دکه‌ی غذای خیابونی تو سنگاپور ستاره داد."}, {"i": 48, "t0": 197.56, "t1": 203.94, "text": "یه بشقاب برنج و مرغ با سس سویا، به قیمت حدود دو دلار سنگاپور، یعنی کمتر از دو دلار آمریکا."}, {"i": 49, "t0": 203.62, "t1": 206.92, "text": "شد ارزون‌ترین غذای ستاره‌دار دار دنیا."}, {"i": 50, "t0": 206.78, "t1": 209.8, "text": "مردم ساعت‌ها واسس تو صف وای وایمیستادن."}, {"i": 51, "t0": 209.56, "t1": 212.92, "text": "البته سال 2021 ستاره‌شو شاید دست داد."}, {"i": 52, "t0": 213.68, "t1": 217.26, "text": "پس ستاره رو به غذای توی بشقاب می‌دن، نه به دکور."}, {"i": 53, "t0": 218.26, "t1": 221.94, "text": "ولی این ستاره یه روی دیگه هم داره استرس."}, {"i": 54, "t0": 221.36, "t1": 232.34, "text": "سال 2017 یه سرآشپز فرانسوی به اسم سباستین برا، که رستورانش نزدیک 20 سال سه ستاره داشت، رسماً از میشلین خواست اسمشو از کتاب خط بزنه."}, {"i": 55, "t0": 232.66, "t1": 238.41, "text": "گفت از این استرس خسته شده که هر بشقابی که از آشپزخونه بیرون می‌ره، ممکنه بشقاب بازرس باشه."}, {"i": 56, "t0": 239.07, "t1": 242.35, "text": "میشلین قبول کرد و رستورانش تو چاپ 2018 نبود."}, {"i": 57, "t0": 242.89, "t1": 247.63, "text": "ولی یه سال بعد، تو چاپ 2019 اسمش دوباره برگشت."}, {"i": 58, "t0": 247.45, "t1": 249.05, "text": "این بار با دو ستاره."}, {"i": 59, "t0": 249.27, "t1": 250.79, "text": "خودش گفت قافل غافلگیر شد."}, {"i": 60, "t0": 251.21, "t1": 251.81, "text": "چرا؟"}, {"i": 61, "t0": 251.69, "t1": 255.53, "text": "چون میشلین می‌گه این کتاب واسه مشتری‌هاست، هست نه واسه سرآشپزها."}, {"i": 62, "t0": 255.87, "t1": 258.91, "text": "یعنی تصمیمش دست آشپز نیست که تو کتاب باشه یا نه."}, {"i": 63, "t0": 259.47, "t1": 261.69, "text": "یه نکته‌ی دیگه هم هست که کم کمتر کسی می‌دونه."}, {"i": 64, "t0": 262.01, "t1": 265.67, "text": "میشلین از رستوران‌ها ها پول نمی‌گیره، ولی از شهرها ها می‌گیره."}, {"i": 65, "t0": 266.21, "t1": 271.65, "text": "مثلاً سه تا شهر تو فلوریدا با هم حدود یک کنیم میلیون دلار دادن تا بارزس‌های های میشلین بیان سراغشون."}, {"i": 66, "t0": 271.05, "t1": 274.45, "text": "ولی پول، ستاره نمی‌خره."}, {"i": 67, "t0": 274.97, "t1": 280.11, "text": "سال اول، بعد رستوران‌های های تامپا با اینکه که شهرشون پول داده بود، هیچ ستاره‌ای ای نگرفتن."}, {"i": 68, "t0": 280.13, "t1": 283.73, "text": "پس پول فقط بازرسو صبح شهر میاره، ستاره رو به رستوران."}, {"i": 69, "t0": 284.25, "t1": 288.37, "text": "با این حال منتقدها می‌گن شهری که پول نده، اصلاً دیده نمی‌شه."}, {"i": 70, "t0": 288.65, "t1": 295.45, "text": "پس جمع جمع‌بندی ستاره‌ی میشلین از یه ترفند فروش لاستیک شروع شد که مردم بیشتر رانندگی کنن."}, {"i": 71, "t0": 294.85, "t1": 301.13, "text": "امروز همون ستاره‌ها ها می‌تونن یه رستوران رو یه یه‌شبه معروف کنن، یا آشپزشو با استرس خسته کنن."}, {"i": 72, "t0": 301.57, "t1": 307.13, "text": "دفعه‌ی بعد که اسم رستوران ستاره‌دار رو شنیدی، یادت باشه همه همه‌چیز برای فروش لاستیک بیشتر بود"}, {"i": 73, "t0": 307.91, "t1": 310.59, "text": "ذره‌بین دست شماست؛ شما بگین بعدی رو کجا بذاریم؟"}], "words": [{"w": "می‌دونستی", "t0": 0.02, "t1": 0.74, "s": 0}, {"w": "معتبرترین", "t0": 0.74, "t1": 1.62, "s": 0}, {"w": "جایزه‌ی", "t0": 1.62, "t1": 1.98, "s": 0}, {"w": "آشپزی", "t0": 1.98, "t1": 2.54, "s": 0}, {"w": "دنیا", "t0