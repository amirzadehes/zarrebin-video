{"sentences": [{"i": 0, "t0": 0, "t1": 5.44, "text": "معتبرترین جایزه‌ی آشپزی دنیا یا همون ستاره‌های میشلین از کجا میاد؟"}, {"i": 1, "t0": 5.04, "t1": 8.84, "text": "یه شرکت لاستیک از کجا می‌فهمه کدوم غذا بهترینه؟"}, {"i": 2, "t0": 8.44, "t1": 10.86, "text": "برگردیم به سال ۱۹۰۰."}, {"i": 3, "t0": 10.74, "t1": 13.66, "text": "اون موقع کل فرانسه کمتر از ۳ هزار تا ماشین داشت."}, {"i": 4, "t0": 13.58, "t1": 20.32, "text": "برادرهای میشلین لاستیک می‌ساختن، ولی یه مشکل داشتن: لاستیک فقط وقتی از بین می‌ره که ماشین راه بره."}, {"i": 5, "t0": 20.3, "t1": 22.2, "text": "پس یه فکر عجیب کردن."}, {"i": 6, "t0": 21.72, "t1": 28.36, "text": "یه کتاب راهنمای مجانی دادن دست راننده‌ها: نقشه، پمپ بنزین، تعمیرگاه، هتل و رستوران."}, {"i": 7, "t0": 27.8, "t1": 36.2, "text": "هدف ساده بود: مردم بیشتر سفر کنن، لاستیکشون زودتر از بین بره و لاستیک نو بخرن."}, {"i": 8, "t0": 35.98, "t1": 41.02, "text": "سال ۱۹۲۶ میشلین به بهترین رستوران‌های کتاب ستاره داد."}, {"i": 9, "t0": 41.22, "t1": 43.6, "text": "حالا معنی ستاره‌ها رو ببین:"}, {"i": 10, "t0": 44.04, "t1": 48.7, "text": "یک ستاره یعنی یه رستوران خیلی خوب که می‌صرفه برای غذا اونجا وایسی"}, {"i": 11, "t0": 48.94, "t1": 52.78, "text": "دو ستاره یعنی ارزش داره مسیرتو براش کج کنی."}, {"i": 12, "t0": 53.14, "t1": 56.86, "text": "سه ستاره یعنی ارزش داره فقط به خاطرش سفر کنی."}, {"i": 13, "t0": 57.16, "t1": 57.82, "text": "دیدی؟"}, {"i": 14, "t0": 57.7, "t1": 60.54, "text": "ستاره‌ها با کیلومتر اندازه گرفته می‌شن."}, {"i": 15, "t0": 60.16, "t1": 63.34, "text": "هر ستاره‌ی بیشتر یعنی رانندگی بیشتر."}, {"i": 16, "t0": 62.78, "t1": 65.78, "text": "یعنی همون فروش لاستیک بیشتر"}, {"i": 17, "t0": 65.3, "t1": 68.9, "text": "ولی هیچ رستورانی نمی‌تونه این ستاره رو بخره."}, {"i": 18, "t0": 69.16, "t1": 71.9, "text": "بازرس‌های میشلین ناشناسن."}, {"i": 19, "t0": 71.54, "t1": 77.26, "text": "با اسم جعلی میز رزرو می‌کنن، مثل یه مشتری معمولی غذا می‌خورن و صورت‌حسابو خودشون می‌دن."}, {"i": 20, "t0": 77.46, "t1": 80.4, "text": "سرآشپز هیچ‌وقت نمی‌دونه کدوم مشتری بازرسه."}, {"i": 21, "t0": 80.14, "t1": 84.86, "text": "پس هر بشقابی که از آشپزخونه بیرون می‌ره، باید عالی باشه."}, {"i": 22, "t0": 84.72, "t1": 88.12, "text": "واسه همین این ستاره‌ها این‌قدر کمیابن."}, {"i": 23, "t0": 87.98, "t1": 93.4, "text": "امروز تو کل دنیا فقط حدود ۱۵۰ رستوران سه ستاره دارن."}, {"i": 24, "t0": 93.24, "t1": 104.26, "text": "پس دفعه‌ی بعد که اسم یه رستوران ستاره‌دار رو شنیدی، یادت باشه: معتبرترین جایزه‌ی آشپزی دنیا، از یه ترفند فروش لاستیک شروع شد."}, {"i": 25, "t0": 104.88, "t1": 107.9, "text": "کامل ترش تو یوتیوب هست، اونجا میتونی بیشتر از میشلین بدونی"}, {"i": 26, "t0": 109.22, "t1": 111.78, "text": "ذره‌بین دست شماست؛ بگین بعدی رو کجا بذاریم؟"}], "words": [{"w": "معتبرترین", "t0": 0.04, "t1": 0.96, "s": 0}, {"w": "جایزه‌ی", "t0": 1.2, "t1": 1.66, "s": 0}, {"w": "آشپزی", "t0": 1.76, "t1": 2.18, "s": 0}, {"w": "دنیا", "t0": 2.18, "t1": 2.58, "s": 0}, {"w": "یا", "t0": 2.58, "t1": 2.76, "s": 0}, {"w": "همون", "t0": 2.76, "t1": 3.02, "s": 0}, {"w": "ستاره‌های", "t0": 3.02, "t1": 3.84, "s": 0}, {"w": "میشلین", "t0": 3.96, "t1": 4.26, "s": 0}, {"w": "از", "t0": 4.26, "t1": 4.42, "s": 0}, {"w": "کجا", "t0": 4.42, "t1": 4.92, "s": 0}, {"w": "میاد؟", "t0": 4.92, "t1": 5.44, "s": 0}, {"w": "یه", "t0": 5.16, "t1": 5.8, "s": 1}, {"w": "شرکت", "t0": 5.8, "t1": 6.12, "s": 1}, {"w": "لاستیک", "t0": 6.12, "t1": 6.54, "s": 1}, {"w": "از", "t0": 6.54, "t1": 6.72, "s": 1}, {"w": "کجا", "t0": 6.72, "t1": 7.14, "s": 1}, {"w": "می‌فهمه", "t0": 7.14, "t1": 7.42, "s": 1}, {"w": "کدوم", "t0": 7.42, "t1": 7.78, "s": 1}, {"w": "غذا", "t0": 7.78, "t1": 8.0, "s": 1}, {"w": "بهترینه؟", "t0": 8.0, "t1": 8.84, "s": 1}, {"w": "برگردیم", "t0": 8.56, "t1": 9.42, "s": 2}, {"w": "به", "t0": 9.42, "t1": 9.52, "s": 2}, {"w": "سال", "t0": 9.52, "t1": 9.66, "s": 2}, {"w": "۱۹۰۰.", "t0": 9.66, "t1": 10.86, "s": 2}, {"w": "اون", "t0": 10.86, "t1": 10.94, "s": 3}, {"w": "موقع", "t0": 10.94, "t1": 11.06, "s": 3}, {"w": "کل", "t0": 11.06, "t1": 11.34, "s": 3}, {"w": "فرانسه", "t0": 1