{"sentences": [{"i": 0, "t0": 0, "t1": 7.92, "text": "آیا می‌دونستید که معتبرترین قاضی قضاهای دنیا یک شرکت تولید لاستیک هست؟ بله،"}, {"i": 1, "t0": 7.8, "t1": 12.42, "text": "همین شرکت میشلین که امروز با راهنمای میشلین می‌شناسیم."}, {"i": 2, "t0": 12.42, "t1": 15.84, "text": "در ابتدا فقط یک کارخانه لاستیک‌سازی بود."}, {"i": 3, "t0": 16.1, "t1": 22.68, "text": "در سال ۱۹۰۰ دو برادر برای فروش بیشتر لاستیک یک کتابچه قرمز ساختند."}], "words": [{"w": "آیا", "t0": 0.0, "t1": 0.5, "s": 0}, {"w": "می‌دونستید", "t0": 0.64, "t1": 1.14, "s": 0}, {"w": "که", "t0": 1.14, "t1": 1.26, "s": 0}, {"w": "معتبرترین", "t0": 1.26, "t1": 1.98, "s": 0}, {"w": "قاضی", "t0": 2.34, "t1": 2.98, "s": 0}, {"w": "قضاهای", "t0": 2.98, "t1": 3.64, "s": 0}, {"w": "دنیا", "t0": 3.64, "t1": 4.08, "s": 0}, {"w": "یک", "t0": 4.08, "t1": 4.74, "s": 0}, {"w": "شرکت", "t0": 4.74, "t1": 5.22, "s": 0}, {"w": "تولید", "t0": 5.22, "t1": 5.62, "s": 0}, {"w": "لاستیک", "t0": 5.62, "t1": 6.16, "s": 0}, {"w": "هست؟", "t0": 6.16, "t1": 6.68, "s": 0}, {"w": "بله،", "t0": 6.58, "t1": 7.92, "s": 0}, {"w": "همین", "t0": 7.92, "t1": 8.14, "s": 1}, {"w": "شرکت", "t0": 8.14, "t1": 8.66, "s": 1}, {"w": "میشلین", "t0": 8.66, "t1": 9.08, "s": 1}, {"w": "که", "t0": 9.08, "t1": 9.52, "s": 1}, {"w": "امروز", "t0": 9.52, "t1": 10.0, "s": 1}, {"w": "با", "t0": 10.0, "t1": 10.18, "s": 1}, {"w": "راهنمای", "t0": 10.18, "t1": 10.84, "s": 1}, {"w": "میشلین", "t0": 10.84, "t1": 11.3, "s": 1}, {"w": "می‌شناسیم.", "t0": 11.3, "t1": 12.42, "s": 1}, {"w": "در", "t0": 12.54, "t1": 12.72, "s": 2}, {"w": "ابتدا", "t0": 12.72, "t1": 13.0, "s": 2}, {"w": "فقط", "t0": 13.0, "t1": 13.8, "s": 2}, {"w": "یک", "t0": 13.8, "t1": 14.0, "s": 2}, {"w": "کارخانه", "t0": 14.0, "t1": 14.52, "s": 2}, {"w": "لاستیک‌سازی", "t0": 14.52, "t1": 14.98, "s": 2}, {"w": "بود.", "t0": 15.28, "t1": 15.84, "s": 2}, {"w": "در", "t0": 16.22, "t1": 16.38, "s": 3}, {"w": "سال", "t0": 16.38, "t1": 16.56, "s": 3}, {"w": "۱۹۰۰", "t0": 16.56, "t1": 17.28, "s": 3}, {"w": "دو"