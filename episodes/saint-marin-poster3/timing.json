{"sentences": [{"i": 0, "t0": 0, "t1": 3.02, "text": "امروز بخواهم داستان رجه سنت مارتین رو تعریف کنم."}, {"i": 1, "t0": 3.18, "t1": 10.04, "text": "همون که تو نوامر بچه ها تو آلمان فانوس به دست و خیابون پشتی سرباز رومی حرکت میکنن و شام کباب قاز میخورن."}, {"i": 2, "t0": 10.4, "t1": 12.0, "text": "مواد لازم واسه داستان."}, {"i": 3, "t0": 11.9, "t1": 15.88, "text": "سرباز رومی، شنل، مراسم خاک سپاری و مالیات."}, {"i": 4, "t0": 16.0, "t1": 17.18, "text": "بریم سراغ اول ماجرم."}, {"i": 5, "t0": 17.62, "t1": 23.3, "text": "حدود سال 316 پسری به اسم مارتین تو شهری تو مجارستان به دنیا اومد."}, {"i": 6, "t0": 22.7, "t1": 27.58, "text": "باباش افسر ارتش روم بود و مارتینم پونزه سالگی مجبور شد سرواز بشه"}, {"i": 7, "t0": 28.1, "t1": 32.62, "text": "میگن هیچده ساله بود که یه شب سرد تو شهر آمین فرانسه یه"}, {"i": 8, "t0": 32.5, "t1": 35.88, "text": "گدای تقریبا لخ دید که از سرمو میلرزید پولی"}, {"i": 9, "t0": 35.76, "t1": 37.26, "text": "نداشت که بهش بده پس"}, {"i": 10, "t0": 37.14, "t1": 42.5, "text": "شنل ارتشیشو با شمشیر از وسط نصف کرد و نصفشو داد بهش میگن"}, {"i": 11, "t0": 42.38, "t1": 45.44, "text": "همون شب تو خواب دید مسیح نصف اون شنلو پوشیده"}, {"i": 12, "t0": 45.34, "t1": 48.4, "text": "بعد از این خواب زرتش بیرون اومد تعمید"}, {"i": 13, "t0": 48.28, "t1": 50.32, "text": "گرفت و راهب شد سال"}, {"i": 14, "t0": 50.2, "t1": 52.42, "text": "372 مردم"}, {"i": 15, "t0": 52.3, "t1": 54.7, "text": "شهر تور تو غرب فرانسه خواستن"}, {"i": 16, "t0": 54.58, "t1": 56.88, "text": "مارتین اوزخوفشون بشه اوزخوف"}, {"i": 17, "t0": 56.76, "t1": 58.5, "text": "یعنی رهبر مذهبی"}, {"i": 18, "t0": 58.38, "t1": 59.42, "text": "یه شهر مسیحی"}, {"i": 19, "t0": 59.82, "t1": 69.73, "text": "ولی مارتین فکر میکرد که این مقام واسهش خیلی زیاده دیگه میگن رفت تو طویله قازها قایم شد که مردم دست سرش بردارن. ولی قازها اونقدر شلوک کردن که لوش دادن."}, {"i": 20, "t0": 70.15, "t1": 73.61, "text": "و در نهایت شد اصخوف شهر رو بعد از مرگش قدیس."}, {"i": 21, "t0": 74.01, "t1": 77.01, "text": "میگن شاید کباب قاز تو این شب به خطر همین موضوع باشه."}, {"i": 22, "t0": 77.61, "t1": 80.53, "text": "خب، حالا بریم سر خود یازده نوامر."}, {"i": 23, "t0": 81.41, "t1": 85.19, "text": "معمولا روزی که بسمی یه قدیس نام گذاری می شه روز مرگشه پس"}, {"i": 24, "t0": 85.07, "t1": 87.83, "text": "انتظار داری یازده نوام روز مرگ مارتین باشه"}, {"i": 25, "t0": 88.55, "t1": 89.49, "text": "ولی نیست"}, {"i": 26, "t0": 90.17, "t1": 93.13, "text": "مارتین هشت نوام رساله سی سد و نوهد و هفت وقتی"}, {"i": 27, "t0": 93.01, "t1": 95.09, "text": "حدود هشت دوده یک سالش بود تو"}, {"i": 28, "t0": 94.97, "t1": 99.55, "text": "رستای کند حدود پنجاه کلومت اونور تر از تور شهری که اصخفش بود مرد"}, {"i": 29, "t0": 100.13, "t1": 103.31, "text": "مردم کند و مردم تور سر محل خاک سپاریش دعوا کردن"}, {"i": 30, "t0": 103.69, "t1": 106.61, "text": "میگن مردم تور شبونه پیکرش رو ورداشتن سه"}, {"i": 31, "t0": 106.49, "t1": 108.25, "text": "روز از راه رودخونه بردنش و"}, {"i": 32, "t0": 108.13, "t1": 110.33, "text": "یازده نوامر تو تور خاک سپاریش کردن"}, {"i": 33, "t0": 111.11, "t1": 115.03, "text": "پس برخلاف بقیه از اصخفه روز خاک سپاری اینقدیس مهم میشه نه"}, {"i": 34, "t0": 114.91, "t1": 115.65, "text": "روز مرگش"}, {"i": 35, "t0": 116.53, "t1": 120.23, "text": "حالا این داستان سنت مارتین یه ربطی هم به مارتین لوتر داره"}, {"i": 36, "t0": 120.75, "t1": 123.69, "text": "مارتین لوتر که بنیان گذاره کلیسای پورتستانه ده"}, {"i": 37, "t0": 123.57, "t1": 129.28, "text": "نوامر 1483 به دنیا اومد و فرداش تعمیدش دادن واسه همین اسمشو گذاشتن مارتین"}, {"i": 38, "t0": 130.26, "t1": 137.28, "text": "برگردیم سر داستان کباب غاز افثانه ی طویلی غازا قشنگه ولی تاریخ نویسان میگن به احتمال زیاد غاز"}, {"i": 39, "t0": 137.16, "t1": 138.98, "text": "ربطی به خود سنت مارتین نداره"}, {"i": 40, "t0": 139.68, "t1": 141.34, "text": "قضیه چند اتفاق توی"}, {"i": 41, "t0": 141.22, "t1": 142.04, "text": "یک تاریخه"}, {"i": 42, "t0": 142.64, "t1": 145.7, "text": "اون زمان یازده نوامر آخر سال کشاورزی"}, {"i": 43, "t0": 145.58, "t1": 147.2, "text": "بود و روز پرداخت اجاره"}, {"i": 44, "t0": 147.08, "t1": 147.68, "text": "و مالیات"}, {"i": 45, "t0": 148.06, "t1": 151.28, "text": "خیلی آیجاره خونه یا مالیاتشون رو با غاز پرداخت می کردن و"}, {"i": 46, "t0": 151.16, "t1": 153.86, "text": "غاز هم تو این فصل در چاق ترین حالت خودشون بودن"}, {"i": 47, "t0": 154.4, "t1": 155.62, "text": "یه اتفاق دیگم هست"}, {"i": 48, "t0": 156.04, "t1": 160.36, "text": "از همین روز یه روزی چهل روزه تا کریسمس شروع می شد و"}, {"i": 49, "t0": 160.24, "t1": 162.32, "text": "خوردن گوشت ممنوع بود پس"}, {"i": 50, "t0": 162.2, "t1": 164.06, "text": "شب قبلش همه می ریختن سر غاز"}, {"i": 51, "t0": 164.94, "t1": 169.48, "text": "یعنی تاریخ سنت مارتین تصادفاً با پایان سال کشاورزی و"}, {"i": 52, "t0": 169.36, "t1": 170.78, "text": "شروع روزه یکی شد"}, {"i": 53, "t0": 170.66, "t1": 173.34, "text": "و گاز همینجوری اومد سر صفری این شب"}, {"i": 54, "t0": 174.58, "t1": 176.84, "text": "خالا موضوع بعدی فانوسه که"}, {"i": 55, "t0": 176.72, "t1": 179.68, "text": "چرا بچه ها تو این شب فانوس دستشون میگیرند این"}, {"i": 56, "t0": 179.56, "t1": 181.54, "text": "یکی جواب مشخص نداره و"}, {"i": 57, "t0": 181.42, "t1": 184.42, "text": "چند سنت کنار هم نشسته یکی"}, {"i": 58, "t0": 184.3, "t1": 185.22, "text": "این که میگن روز"}, {"i": 59, "t0": 185.1, "t1": 186.96, "text": "مراسم خاک سپاری مارتین مردم"}, {"i": 60, "t0": 186.84, "t1": 189.06, "text": "فانوس همراهشون بوده یکی"}, {"i": 61, "t0": 188.94, "t1": 197.29, "text": "دیگه جشن پایان برداشت و پاییز تو مزرعه ها آتیش روشن میکردن و بچه ها از کاه و شلغم مشعل و فانوس درست میکردن"}, {"i": 62, "t0": 197.75, "t1": 200.91, "text": "رجعه فانوس به شکل امروزی خیلی تازه است"}, {"i": 63, "t0": 201.15, "t1": 204.37, "text": "اولین رجعه های سازمانی آفته تو راینلند آلمان حدود"}, {"i": 64, "t0": 204.25, "t1": 207.61, "text": "سال 1887 و 1890 بودن و"}, {"i": 65, "t0": 207.49, "t1": 210.43, "text": "از حدود 1900 همه جا پخش شد یعنی"}, {"i": 66, "t0": 210.31, "t1": 213.85, "text": "داستان خود سنت مارتین 1600 ساله است ولی"}, {"i": 67, "t0": 213.73, "t1": 217.13, "text": "رجعه فانوس فقط حدود 150 ساله که بهش اضافه شده"}, {"i": 68, "t0": 217.25, "t1": 220.09, "text": "حالا ببینیم توی این رژه چی میگذره"}, {"i": 69, "t0": 220.69, "t1": 223.41, "text": "تو رژه یه نفر لباس سرباز رومی میپوشه و"}, {"i": 70, "t0": 223.29, "t1": 224.99, "text": "سوار عصب جلو میره اون"}, {"i": 71, "t0": 224.87, "t1": 226.57, "text": "خود مارتینه بچه"}, {"i": 72, "t0": 226.45, "t1": 228.85, "text": "ها پشتش فانوس به دست میرن و آهنگ میخونن"}, {"i": 73, "t0": 229.21, "t1": 231.81, "text": "وسط راه سوار شمشیر میکشه شنل"}, {"i": 74, "t0": 231.69, "t1": 235.69, "text": "رو نصف میکنه و نصفشو به کسی میده که نقش گدار رو داره آخرش"}, {"i": 75, "t0": 235.57, "t1": 237.25, "text": "هم یه آتیش بزرگ روشن میکنن"}, {"i": 76, "t0": 237.85, "t1": 240.19, "text": "البته اینجا بچه ها نقش گدار رو ندارن"}, {"i": 77, "t0": 240.11, "t1": 243.29, "text": "بلکه دنبال مارتین میرن و خودشون فانوس میبرن و"}, {"i": 78, "t0": 243.17, "t1": 247.67, "text": "یاد میگیرن که تقسیم کردن چیزی که دارن با بقیه یعنی چی؟ پس"}, {"i": 79, "t0": 247.55, "t1": 249.09, "text": "جهانبندی یه"}, {"i": 80, "t0": 248.97, "t1": 251.89, "text": "سرباز که نصف شنلشو بخشید ولی"}, {"i": 81, "t0": 251.77, "t1": 255.73, "text": "کباب غاز یادگار یه تداخل تاریخیه مالیات"}, {"i": 82, "t0": 255.61, "t1": 256.37, "text": "و روزه"}, {"i": 83, "t0": 256.71, "t1": 257.93, "text": "ذرابین دست شماست"}, {"i": 84, "t0": 258.13, "t1": 259.65, "text": "شما بگین بعدیو کجا بذاریم"}], "words": [{"w": "امروز", "t0": 0.0, "t1": 0.44, "s": 0}, {"w": "بخواهم", "t0": 0.44, "t1": 0.64, "s": 0}, {"w": "داستان", "t0": 0.64, "t1": 1.02, "s": 0}, {"w": "رجه", "t0": 1.02, "t1": 1.4, "s": 0}, {"w": "سنت", "t0": 1.4, "t1": 1.88, "s": 0}, {"w": "مارتین", "t0": 1.88, "t1": 2.34, "s": 0}, {"w": "رو", "t0": 2.34, "t1": 2.4, "s": 0}, {"w": "تعریف", "t0": 2.4, "t1": 2.7, "s": 0}, {"w": "کنم.", "t0": 2.7, "t1": 3.02, "s": 0}, {"w": "همون", "t0": 3.3, "t1": 3.48, "s": 1}, {"w": "که", "t0": 3.48, "t1": 3.56, "s": 1}, {"w": "تو", "t0": 3.5