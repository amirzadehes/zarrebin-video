{"sentences": [{"i": 0, "t0": 0.0, "t1": 4.392, "text": "قهوه واقعا باتری مخ‌مون می‌شه یا فقط یک هکر مهربون؟"}, {"i": 1, "t0": 4.612, "t1": 9.148, "text": "بگذار ببینم چرا این نوشیدنی صبح‌گاهی این‌قدر جذابه."}, {"i": 2, "t0": 9.698, "t1": 16.586, "text": "صبح‌ها وقتی اولین لیوان قهوه یا چای رو می‌نوشیم، حس می‌کنیم که تمام سیستم‌مون روشن می‌شود."}, {"i": 3, "t0": 16.806, "t1": 20.214, "text": "اما کافئین واقعا به ما انرژی می‌دهد؟"}, {"i": 4, "t0": 20.434, "t1": 22.306, "text": "نه."}, {"i": 5, "t0": 22.526, "t1": 26.39, "text": "در واقع کافئین بزرگ‌ترین هکر سیستم عصبی‌ست."}, {"i": 6, "t0": 26.94, "t1": 32.58, "text": "از لحظه بیدار شدن، ماده‌ای به اسم آدنوزین در مغز شروع به ترشح می‌کند."}, {"i": 7, "t0": 32.8, "t1": 38.128, "text": "هر چه روز می‌گذرد، آدنوزین بیشتر می‌شود و روی گیرنده‌ها می‌نشیند."}, {"i": 8, "t0": 38.348, "t1": 43.604, "text": "وقتی این گیرنده‌ها پر می‌شوند، مغز می‌گوید «خسته‌ام، باید بخوابم»."}, {"i": 9, "t0": 43.824, "t1": 47.16, "text": "این همان حس خمیازه‌کشیدن شب‌هاست."}, {"i": 10, "t0": 47.71, "t1": 51.094, "text": "کافئین ساختاری شبیه آدنوزین دارد."}, {"i": 11, "t0": 51.314, "t1": 56.426, "text": "وقتی می‌نوشیم، کافئین به جای آدنوزین روی همان گیرنده‌ها می‌نشیند."}, {"i": 12, "t0": 56.646, "t1": 60.87, "text": "یعنی کلید تقلبی‌ای که قفل خستگی را مسدود می‌کند."}, {"i": 13, "t0": 61.09, "t1": 64.282, "text": "بنابراین مغز نمی‌فهمد که خسته است."}, {"i": 14, "t0": 64.832, "t1": 67.856, "text": "اما این فقط یک بخش از ماجراست."}, {"i": 15, "t0": 68.076, "t1": 72.996, "text": "آدنوزین در حالت عادی مثل ترمز برای دوپامین عمل می‌کند."}, {"i": 16, "t0": 73.216, "t1": 77.08, "text": "دوپامین هورمون لذت، انگیزه و تمرکز است."}, {"i": 17, "t0": 77.3, "t1": 82.724, "text": "وقتی کافئین آدنوزین را بلاک می‌کند، ترمز دوپامین برداشته می‌شود."}, {"i": 18, "t0": 82.944, "t1": 84.816, "text": "نتیجه؟"}, {"i": 19, "t0": 85.036, "t1": 90.7, "text": "سیگنال دوپامین قوی‌تر می‌شود و حس خوشحالی، تمرکز و انرژی می‌گیریم."}, {"i": 20, "t0": 91.25, "t1": 94.394, "text": "کافئین فقط روی مغز کار نمی‌کند."}, {"i": 21, "t0": 94.614, "t1": 99.63, "text": "گیرنده‌های آدنوزین در سیستم عصبی سمپاتیک هم بلاک می‌شوند."}, {"i": 22, "t0": 99.85, "t1": 104.074, "text": "این باعث می‌شود هورمون آدرنالین بیشتر ترشح شود."}, {"i": 23, "t0": 104.294, "t1": 111.902, "text": "آدرنالین ضربان قلب را بالا می‌برد، رگ‌ها را کمی منقبض می‌کند و بدن را در حالت «آماده‌باش» می‌گذارد."}, {"i": 24, "t0": 112.122, "t1": 120.954, "text": "برای افراد حساس یا کسانی که قهوه را با معده خالی می‌نوشند، این می‌تواند تپش قلب، لرزش دست یا اضطراب ایجاد کند."}, {"i": 25, "t0": 121.504, "t1": 124.552, "text": "اثر کافئین چند ساعت طول می‌کشد."}, {"i": 26, "t0": 124.772, "t1": 131.852, "text": "نیمه‌عمر آن حدود پنج ساعت است، اما بین سه تا هفت ساعت بسته به فرد متفاوت است."}, {"i": 27, "t0": 132.072, "t1": 138.6, "text": "وقتی اثر کافئین از بین می‌رود، آدنوزین‌های مسدود نشده دوباره روی گیرنده‌ها می‌نشینند."}, {"i": 28, "t0": 138.82, "t1": 143.476, "text": "به همین دلیل پس از پایان اثر، احساس خستگی شدید می‌کنیم."}, {"i": 29, "t0": 143.696, "t1": 146.672, "text": "این حالت را «کافئین کرش» می‌نامند."}, {"i": 30, "t0": 147.222, "t1": 151.11, "text": "چرا بعضی‌ها می‌گویند قهوه رویشان تأثیری ندارد؟"}, {"i": 31, "t0": 151.33, "t1": 153.874, "text": "دو دلیل اصلی وجود دارد."}, {"i": 32, "t0": 154.094, "t1": 156.254, "text": "اول، ژنتیک."}, {"i": 33, "t0": 156.474, "t1": 162.234, "text": "برخی افراد آنزیم CYP1A2 را دارند که کافئین را سریع‌تر تجزیه می‌کند."}, {"i": 34, "t0": 162.454, "t1": 165.022, "text": "دوم، مقاومت مغزی."}, {"i": 35, "t0": 165.242, "t1": 172.034, "text": "اگر هر روز قهوه بخورید، مغز گیرنده‌های جدیدی می‌سازد تا بتواند آدنوزین را جذب کند."}, {"i": 36, "t0": 172.254, "t1": 176.814, "text": "در نتیجه برای همان اثر باید دو فنجان یا بیشتر بنوشید."}, {"i": 37, "t0": 177.034, "t1": 185.074, "text": "اگر یک روز قهوه نخورید، این گیرنده‌های اضافه با آدنوزین پر می‌شوند و سردرد و خستگی شدیدی ایجاد می‌کند."}, {"i": 38, "t0": 185.624, "t1": 188.816, "text": "قهوه یا چای، کدام قوی‌تر است؟"}, {"i": 39, "t0": 189.036, "t1": 199.452, "text": "یک فنجان قهوه معمولی حدود ۹۰ تا ۱۰۰ میلی‌گرم کافئین دارد؛ در حالی که چای سیاه حدود ۴۵ تا ۵۰ میلی‌گرم و چای سبز حتی کمتر دارد."}, {"i": 40, "t0": 199.672, "t1": 204.352, "text": "بنابراین قهوه تقریباً دو برابر کافئین وارد سیستم می‌کند."}, {"i": 41, "t0": 204.572, "t1": 212.228, "text": "اما چای حاوی ال‑تیانین است که اثر کافئین را نرم‌تر و متمرکزتر می‌کند، بدون تپش قلب یا بی‌قراری."}, {"i": 42, "t0": 212.778, "t1": 221.61, "text": "خلاصه اینکه قهوه مثل یک چکش قوی روی گیرنده‌های خستگی می‌زند، در حالی که چای همان کار را با دستکش مخملی انجام می‌دهد."}, {"i": 43, "t0": 221.83, "t1": 226.942, "text": "هر دو هکرهای سیستم عصبی‌اند؛ یکی خشن‌تر و دیگری مودب‌تر."}, {"i": 44, "t0": 227.492, "t1": 235.94, "text": "دفعه بعد که لیوان قهوه‌تان را می‌گیرید، به یاد داشته باشید که در حال استفاده از یک وام با بهره بالا برای مخ‌تان هستید."}, {"i": 45, "t0": 236.16, "t1": 241.44, "text": "برای کشف بیشتر این رازهای علمی، حتماً «ذره‌بین» را دنبال کنید."}], "words": [{"w": "قهوه", "t0": 0.163, "t1": 0.388, "s": 0}, {"w": "واقعا", "t0": 0.463, "t1": 0.838, "s": 0}, {"w": "باتری", "t0": 0.95, "t1": 1.3, "s": 0}, {"w": "مخ‌مون", "t0": 1.325, "t1": 1.712, "s": 0}, {"w": "می‌شه", "t0": 1.712, "t1": 1.987, "s": 0}, {"w": "یا", "t0": 1.988, "t1": 2.138, "s": 0}, {"w": "فقط", "t0": 2.138, "t1": 2.425, "s": 0}, {"w": "یک", "t0": 2.5, "t1": 2.58, "s": 0}, {"w": "هکر", "t0": 2.675, "t1": 2.925, "s": 0}, {"w": "مهربون؟", "t0": 2.962, "t1": 3.513, "s": 0}, {"w": "بگذار", "t0": 4.825, "t1": 4.987, "s": 1}, {"w": "ببینم", "t0": 5.175, "t1": 5.487, "s": 1}, {"w": "چرا", "t0": 5.562, "t1": 5.775, "s": 1}, {"w": "این", "t0": 5.775, "t1": 5.912, "s": 1}, {"w": "نوشیدنی", "t0": 5.912, "t1": 6.475, "s": 1}, {"w": "صبح‌گاهی", "t0": 6.487, "t1": 7.062, "s": 1}, {"w": "این‌قدر", "t0": 7.287, "t1": 7.712, "s": 1}, {"w": "جذابه.", "t0": 7.762, "t1": 8.225, "s": 1}, {"w": "صبح‌ها", "t0": 10.036, "t1": 10.161, "s": 2}, {"w": "وقتی", "t0": 10.398, "t1": 10.661, "s": 2}, {