{"sentences": [{"i": 0, "t0": 0, "t1": 6.14, "text": "تا حالا فکر کردی توی یک رستوران لوکس، بالاترین قاضی غذا کیه؟"}, {"i": 1, "t0": 5.7, "t1": 8.32, "text": "یه شرکت تولید لاستیک!"}, {"i": 2, "t0": 8.84, "t1": 9.42, "text": "چرا؟"}, {"i": 3, "t0": 9.3, "t1": 12.18, "text": "داستان از سال ۱۹۰۰ شروع می‌شه."}, {"i": 4, "t0": 12.06, "t1": 15.12, "text": "اون موقع توی فرانسه کمتر از سه‌هزار ماشین بود."}, {"i": 5, "t0": 15.0, "t1": 22.28, "text": "دو تا برادر به اسم آندره و ادوارد میشلین که کارخانه لاستیک داشتن، می‌خواستن لاستیک‌هایشون بیشتر بفروشند."}, {"i": 6, "t0": 22.7, "t1": 26.64, "text": "برای این کار باید مردمو تشویق می‌کردن که بیشتر رانندگی کنن."}, {"i": 7, "t0": 26.94, "t1": 29.8, "text": "پس یک کتابچه قرمز رنگ درست کردن."}, {"i": 8, "t0": 29.58, "t1": 35.26, "text": "توش نقشه جاده‌ها، لیست پمپ بنزین، حتی هتل‌ها و غذاخوری‌های بین راه بود."}, {"i": 9, "t0": 34.92, "t1": 43.06, "text": "هدفش این بود که مردم دلیل پیدا کنن تا سفر کنن، لاستیک‌هاشون زودتر ساییده بشه و باز هم لاستیک میشلین بخرید."}, {"i": 10, "t0": 43.7, "t1": 51.2, "text": "این کتابچه توی حدود بیست سال اول رایگان بود، بعد از ۱۹۲۰ پولی شد، چون مردم فقط وقتی پول می‌دن جدی می‌گیرن."}, {"i": 11, "t0": 51.88, "t1": 56.8, "text": "تا دهه ۲۲۰، بخش رستوران‌های کتابچه حسابی پرطرفدار شد."}, {"i": 12, "t0": 57.2, "t1": 63.56, "text": "برادرها تصمیم گرفتن تیمی از بازرس‌های مخفی استخدام کنن تا کیفیت رستوران‌ها رو ارزیابی کنن."}, {"i": 13, "t0": 63.98, "t1": 74.98, "text": "در ۱۹۲۶ سیستم ستاره‌دار راه افتاد؛ اول فقط یک ستاره می‌دادن، بعد توی ۱۹۳۱ سه سطح ستاره (یک، دو، سه) اضافه شد."}, {"i": 14, "t0": 74.86, "t1": 79.38, "text": "جالب اینه که معنی این ستاره‌ها هنوز به سفر و جاده ربط داره:"}, {"i": 15, "t0": 80.1, "t1": 84.66, "text": "یک ستاره = «غذای باکیفیت، ارزش توقف تو مسیر»."}, {"i": 16, "t0": 85.2, "t1": 89.76, "text": "دو ستاره = «آشپزی عالی، ارزش اینکه مسیرتو عوض کنی»."}, {"i": 17, "t0": 90.22, "t1": 96.48, "text": "سه ستاره = «آشپزی استثنایی، ارزش اینکه فقط برای تستش سفر کنی»."}, {"i": 18, "t0": 97.1, "t1": 100.06, "text": "بازرس‌ها مثل کارآگاه‌های مخفی غذا عمل می‌کنن."}, {"i": 19, "t0": 99.68, "t1": 104.76, "text": "هیچ رستورانی نمی‌تونه فرم پر کنه یا پول بده تا ستاره بگیره."}, {"i": 20, "t0": 104.66, "t1": 111.32, "text": "اونا شبکه‌های اجتماعی، وبلاگ‌ها، نقدهای روزنامه و حتی حرف مردم عادی رو زیر نظر می‌گیرن."}, {"i": 21, "t0": 111.64, "t1": 117.43, "text": "وقتی رستوران سر و صدا می‌کنه یا مردم زیاد تعریف می‌کنن، بازرس‌ها به‌صورت ناشناس می‌رن."}, {"i": 22, "t0": 117.15, "t1": 129.65, "text": "فقط پنج فاکتور بررسی می‌کنن: کیفیت مواد، تسلط روی طعم و تکنیک، شخصیت سرآشپز تو غذا، ارزش نسبت به پول و ثبات کیفیت."}, {"i": 23, "t0": 129.73, "t1": 135.19, "text": "به همین دلیل حتی یه دکه خیابونی تو بانکوک به اسم جی فای یک ستاره میشلین داره."}, {"i": 24, "t0": 135.01, "t1": 142.51, "text": "تو می‌نشینی روی چهارپایه پلاستیکی، پیرزن آشپز با عینک ایمنی بزرگ روی زغال می‌پزه، اما غذاش کلاس جهانیه."}, {"i": 25, "t0": 143.09, "t1": 144.27, "text": "حالا بریم سر قیمت‌ها."}, {"i": 26, "t0": 144.09, "t1": 148.05, "text": "تو آمریکا یک شام معمولی حدود ۲۰ دلار می‌خره."}, {"i": 27, "t0": 147.67, "t1": 154.17, "text": "اما یک رستوران یک ستاره میشلین میانگین هزینه‌اش حدود ۱۶۵ دلار برای منوی کامله."}, {"i": 28, "t0": 154.05, "t1": 160.81, "text": "حتی استثنای عجیب مثل تیم هو وان توی هنگ‌کنگ، یک ظرف معمولی فقط ۲ دلار."}, {"i": 29, "t0": 160.79, "t1": 168.79, "text": "دو ستاره‌ها میانگین ۲۵۶ دلار برای هر نفر می‌دن و سه ستاره‌ها می‌رسن به ۳۵۶ دلار."}, {"i": 30, "t0": 168.83, "t1": 175.63, "text": "مثلا آلینیا تو شیکاگو منوی تست ۱۸ مرحله‌ای‌اش حدود ۳۶۰ دلار می‌بره."}, {"i": 31, "t0": 175.31, "t1": 181.91, "text": "یا فرنچ لاندری تو کالیفرنیا با مالیات و انعام راحت بالای ۴۰۰ دلار می‌رسه."}, {"i": 32, "t0": 185.41, "t1": 190.29, "text": "ستاره‌ها دائمی نیستن؛ اگه کیفیت حفظ نشه، ستاره‌گیری می‌ره."}, {"i": 33, "t0": 190.81, "t1": 196.15, "text": "مهم اینه که ستاره به رستوران داده می‌شه، نه به سرآشپز."}, {"i": 34, "t0": 196.03, "t1": 200.31, "text": "و بله، هنوز هم همان شرکت لاستیک‌سازی فرانسوی مالک میشلین‌ست."}, {"i": 35, "t0": 200.69, "t1": 210.47, "text": "کتابچه قرمز «The Red Guide» بعد از صد سال هنوز چاپ می‌شه، حتی اپلیکیشن و وب‌سایت هم داره، اما نسخه چاپی برای سرآشپزها مثل گنجینه‌ست."}, {"i": 36, "t0": 212.93, "t1": 221.79, "text": "پس دفعه بعد که اسم یک رستوران میشلین‌دار به گوش می‌رسه، یادت نره که پشت این تمام لوکس‌گری، یک شرکت لاستیک فرانسوی بوده که"}, {"i": 37, "t0": 221.67, "t1": 224.25, "text": "می‌خواست مردم رو تو جاده‌ها بیشتر ببینه!"}, {"i": 38, "t0": 227.23, "t1": 231.87, "text": "اگه خوشت اومد این داستان، حتماً توی «ذره‌بین» بمان و ما رو دنبال کن."}], "words": [{"w": "تا", "t0": 0.08, "t1": 0.48, "s": 0}, {"w": "حالا", "t0": 0.48, "t1": 0.62, "s": 0}, {"w": "فکر", "t0": 0.62, "t1": 0.8, "s": 0}, {"w": "کردی", "t0": 0.8, "t1": 1.12, "s": 0}, {"w": "توی", "t0": 1.12, "t1": 1.32, "s": 0}, {"w": "یک", "t0": 1.32, "t1": 1.62, "s": 0}, {"w": "رستوران", "t0": 1.62, "t1": 2.24, "s": 0}, {"w": "لوکس،", "t0": 2.24, "t1": 2.72, "s": 0}, {"w": "بالاترین", "t0": 2.72, "t1": 3.86, "s": 0}, {"w": "قاضی", "t0": 3.86, "t1": 4.42, "s": 0}, {"w": "غذا", "t0": 4.42, "t1": 4.92, "s": 0}, {"w": "کیه؟", "t0": 4.92, "t1": 6.14, "s": 0}, {"w": "یه", "t0": 5.82, "t1": 6.56, "s": 1}, {"w": "شرکت", "t0": 6.56, "t1": 6.94, "s": 1}, {"w": "تولید", "t0": 6.94, "t1": 7.32, "s": 1}, {"w": "لاستیک!", "t0": 7.32, "t1": 8.32, "s": 1}, {"w": "چرا؟", "t0": 8.96, "t1": 9.42, "s": 2}, {"w": "داستان", "t0": 9.42, "t1": 10.24, "s": 3}, {"w": "از", "t0": 10.24, "t1": 10.34, "s": 3}, {"w": "سال", "t0": 10.34, "t1": 10.48, "s": 3}, {"w": "۱۹۰۰", "t0": 10.48, "t1": 11.16, "s": 3}, {"w": "شروع", "t0": 11.16, "t1": 11.58, "s": 3}, {"w": "می‌شه.", "t0": 11.58, "t1": 12.18, "s": 3}, {"w": "اون", "t0": 12.18, "t1": 12.32, "s": 4}, {"w": "موقع", "t0": 12.32, "t1": 12.52, "s": 4}, {"w": "توی", "t0": 12.52, "t1": 12.68, "s": 4}, {"w": "فرانسه", "t0": 12.68, "t1": 13.12, "s": 4}, {"w": "کمتر", "t0": 13.12, "t1": 13.44, "s": 4}, {"w": "از", "t0": 13.44, "t1": 13.58, "s": 4}, {"w": "سه‌هزار", "t0": 1