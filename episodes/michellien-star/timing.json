{"sentences": [{"i": 0, "t0": 0, "t1": 4.2, "text": "تصور کن رفتی یکی از لوکس‌ترین رستوران‌های دنیا."}, {"i": 1, "t0": 4.08, "t1": 6.68, "text": "بشقابت پر از شاهکاره."}, {"i": 2, "t0": 6.56, "t1": 8.22, "text": "ولی یه سوال عجیب دارم."}, {"i": 3, "t0": 8.1, "t1": 10.62, "text": "قاضی اصلی این غذا کیه؟"}, {"i": 4, "t0": 10.68, "t1": 12.58, "text": "یه شرکت لاستیک‌سازیه!"}, {"i": 5, "t0": 13.42, "t1": 14.6, "text": "باور نمی‌کنی؟"}, {"i": 6, "t0": 14.82, "t1": 16.28, "text": "بیا باهم بریم تو ماجرا."}, {"i": 7, "t0": 16.4, "t1": 19.3, "text": "داستان از سال ۱۹۰۰ شروع میشه."}, {"i": 8, "t0": 19.18, "t1": 22.24, "text": "تو فرانسه کمتر از سه هزار تا ماشین بود."}, {"i": 9, "t0": 22.12, "t1": 25.5, "text": "رانندگی سخت بود و پمپ بنزین کم."}, {"i": 10, "t0": 25.56, "t1": 27.16, "text": "مردم زیاد سفر نمی‌کردن."}, {"i": 11, "t0": 27.66, "t1": 30.8, "text": "دو برادر به اسم آندره و ادوارد میشلین بودن."}, {"i": 12, "t0": 30.44, "t1": 32.64, "text": "اونا کارخونه لاستیک داشتن."}, {"i": 13, "t0": 33.04, "t1": 34.92, "text": "می‌خواستن لاستیک بیشتر بفروشن."}, {"i": 14, "t0": 34.68, "t1": 38.18, "text": "پس باید مردم رو به رانندگی ترغیب می‌کردن."}, {"i": 15, "t0": 38.72, "t1": 40.58, "text": "چجوری این کار رو کردن؟"}, {"i": 16, "t0": 40.28, "t1": 42.96, "text": "یه کتابچه قرمز رنگ چاپ کردن."}, {"i": 17, "t0": 42.76, "t1": 44.66, "text": "توش نقشه جاده‌ها بود."}, {"i": 18, "t0": 44.46, "t1": 46.68, "text": "روش پنچرگیری هم بود."}, {"i": 19, "t0": 46.56, "t1": 49.94, "text": "لیست پمپ‌ها و رستوران‌های بین راهی هم بود."}, {"i": 20, "t0": 50.14, "t1": 52.3, "text": "منطقشون خیلی هوشمندانه بود."}, {"i": 21, "t0": 52.0, "t1": 54.64, "text": "به مردم دلیل بده سفر کنن."}, {"i": 22, "t0": 54.3, "t1": 56.98, "text": "تا لاستیک‌هاشون زودتر ساییده بشه."}, {"i": 23, "t0": 57.34, "t1": 59.78, "text": "بعد لاستیک جدید میشلین می‌خرن."}, {"i": 24, "t0": 60.36, "t1": 62.16, "text": "این کتابچه بیست سال رایگان بود."}, {"i": 25, "t0": 61.88, "t1": 65.02, "text": "اما از ۱۹۲۰ به بعد پولی شد."}, {"i": 26, "t0": 65.48, "t1": 68.58, "text": "چون مردم چیزی رو جدی می‌گیرن که براش پول بدن."}, {"i": 27, "t0": 69.14, "t1": 71.48, "text": "حالا ستاره‌ها از کجا اومدن؟"}, {"i": 28, "t0": 71.16, "t1": 76.38, "text": "تو همون دهه ۱۹۲۰ متوجه شدن بخش رستوران خیلی پرطرفواره."}, {"i": 29, "t0": 76.82, "t1": 79.76, "text": "تصمیم گرفتن بازرس‌های مخفی استخدام کنن."}, {"i": 30, "t0": 80.34, "t1": 84.4, "text": "سال ۱۹۲۶ سیستم ستاره متولد شد."}, {"i": 31, "t0": 84.58, "t1": 86.42, "text": "اول فقط یک ستاره بود."}, {"i": 32, "t0": 86.32, "t1": 89.42, "text": "از ۱۹۳۱ سه سطحی شد."}, {"i": 33, "t0": 89.32, "t1": 93.06, "text": "نکته جالبش اینه که معنی ستاره‌ها هنوز به جاده ربط داره."}, {"i": 34, "t0": 93.7, "t1": 95.58, "text": "یک ستاره یعنی چی؟"}, {"i": 35, "t0": 95.84, "t1": 97.64, "text": "یعنی غذای باکیفیت."}, {"i": 36, "t0": 97.72, "t1": 100.28, "text": "ارزشش رو داره تو مسیرت اینجا توقف کنی."}, {"i": 37, "t0": 100.76, "t1": 104.06, "text": "دو ستاره یعنی آشپزی عالی."}, {"i": 38, "t0": 104.32, "t1": 106.44, "text": "ارزشش رو داره مسیرت رو کج کنی."}, {"i": 39, "t0": 106.18, "t1": 108.14, "text": "از جاده اصلی خارج بشی."}, {"i": 40, "t0": 108.8, "t1": 112.26, "text": "سه ستاره یعنی آشپزی استثنایی."}, {"i": 41, "t0": 112.06, "t1": 116.04, "text": "ارزشش رو داره فقط برای همین غذا سفر کنی."}, {"i": 42, "t0": 118.56, "t1": 120.7, "text": "بازرس‌ها چیو قضاوت می‌کنن؟"}, {"i": 43, "t0": 121.56, "t1": 124.18, "text": "رستوران‌ها نمی‌تونن درخواست بدن."}, {"i": 44, "t0": 123.98, "t1": 126.92, "text": "هیچ‌کس نمی‌تونه پول بده تا ستاره بگیره."}, {"i": 45, "t0": 126.68, "t1": 129.38, "text": "بازرس‌ها مثل کارآگاه عمل می‌کنن."}, {"i": 46, "t0": 129.1, "t1": 131.48, "text": "شبکه‌های اجتماعی رو رصد می‌کنن."}, {"i": 47, "t0": 131.76, "t1": 133.06, "text": "نقدهای روزنامه‌ها رو می‌خونن."}, {"i": 48, "t0": 132.86, "t1": 136.3, "text": "اگه رستورانی سر و صدا کرد، بازرس‌ها وارد عمل میشن."}, {"i": 49, "t0": 136.12, "t1": 139.36, "text": "وقتی میرن، فقط پنج فاکتور رو بررسی می‌کنن."}, {"i": 50, "t0": 138.98, "t1": 142.08, "text": "اول کیفیت مواد اولیه."}, {"i": 51, "t0": 142.48, "t1": 145.32, "text": "دوم تسلط روی طعم‌ها و پخت."}, {"i": 52, "t0": 145.76, "t1": 148.36, "text": "سوم شخصیت سرآشپز تو غذا."}, {"i": 53, "t0": 148.88, "t1": 151.44, "text": "چهارم ارزش غذا در برابر پول."}, {"i": 54, "t0": 151.12, "t1": 155.12, "text": "پنجم ثبات کیفیت تو بازدیدهای مختلف."}, {"i": 55, "t0": 157.22, "t1": 159.46, "text": "پس جای ساده هم می‌تونه ستاره بگیره؟"}, {"i": 56, "t0": 160.76, "t1": 161.72, "text": "آره دقیقاً."}, {"i": 57, "t0": 161.36, "t1": 163.78, "text": "مثلاً یه دکه خیابونی تو بانکوک."}, {"i": 58, "t0": 163.22, "t1": 164.8, "text": "به اسم جی فای."}, {"i": 59, "t0": 164.42, "t1": 166.5, "text": "یک ستاره میشلین داره."}, {"i": 60, "t0": 166.18, "t1": 168.62, "text": "اونجا روی چهارپایه پلاستیکی می‌شینی."}, {"i": 61, "t0": 168.48, "t1": 170.94, "text": "آشپزش یه پیرزن با عینک ایمنیه."}, {"i": 62, "t0": 170.64, "t1": 172.6, "text": "روی زغال غذا می‌پزه."}, {"i": 63, "t0": 172.46, "t1": 174.58, "text": "ولی غذای کلاس جهانی میده."}, {"i": 64, "t0": 174.36, "t1": 177.3, "text": "بازرس‌ها هم مثل مامور مخفی عمل می‌کنن."}, {"i": 65, "t0": 177.22, "t1": 179.04, "text": "با اسم مستعار میز می‌گیرن."}, {"i": 66, "t0": 178.78, "t1": 180.78, "text": "پول غذا رو از جیب خودشون میدن."}, {"i": 67, "t0": 181.44, "t1": 183.5, "text": "هیچ‌وقت هویتشون رو فاش نمی‌کنن."}, {"i": 68, "t0": 187.14, "t1": 190.26, "text": "اگه بری رستوران ستاره‌دار چقدر پیاده میشی؟"}, {"i": 69, "t0": 190.34, "t1": 193.68, "text": "تو آمریکا شام معمولی حدود ۲۰ دلار تموم میشه."}, {"i": 70, "t0": 193.26, "t1": 196.88, "text": "ولی تو دنیای میشلین قیمت‌ها جهش می‌کنه."}, {"i": 71, "t0": 197.36, "t1": 200.96, "text": "برای یک ستاره، میانگین هزینه ۱۶۵ دلار میشه."}, {"i": 72, "t0": 200.72, "t1": 202.86, "text": "البته استثنا هم داریم."}, {"i": 73, "t0": 202.44, "t1": 205.68, "text": "رستوران تیم هو وان تو هنگ‌کنگ یک ستاره داره."}, {"i": 74, "t0": 205.66, "t1": 208.84, "text": "یه ظرف غذای معمولی اونجا فقط دو دلار قیمت داره."}, {"i": 75, "t0": 208.76, "t1": 210.62, "text": "دو نفر با ۱۷ دلار سیر میشن."}, {"i": 76, "t0": 211.48, "t1": 212.98, "text": "دو ستاره‌ها چطورن؟"}, {"i": 77, "t0": 212.74, "t1": 217.8, "text": "قیمت میانگین جهانی برای هر نفر ۲۵۶ دلار میشه."}, {"i": 78, "t0": 217.86, "t1": 221.08, "text": "وقتی می‌رسیم به سه ستاره، اعداد بالا می‌ره."}, {"i": 79, "t0": 220.94, "t1": 223.66, "text": "میانگین میشه ۳۵۶ دلار برای هر نفر."}, {"i": 80, "t0": 224.2, "t1": 227.54, "text": "مثلاً رستوران آلینیا تو شیکاگو سه ستاره داره."}, {"i": 81, "t0": 227.4, "t1": 231.26, "text": "منوی ۱۸ مرحله‌ایش حدود ۳۶۰ دلار آب می‌خوره."}, {"i": 82, "t0": 230.68, "t1": 232.68, "text": "یا فرنچ لاندری تو کالیفرنیا."}, {"i": 83, "t0": 232.56, "t1": 237.12, "text": "با مالیات و انعام، راحت بالای ۴۰۰ دلار فاکتور می‌ندازه."}, {"i": 84, "t0": 237.7, "t1": 240.06, "text": "حتی رستوران‌هایی هستن که فقط دو ستاره دارن."}, {"i": 85, "t0": 239.7, "t1": 242.6, "text": "ولی برای یه شام ۲۰۰۰ دلار پول می‌گیرن."}, {"i": 86, "t0": 243.06, "t1": 246.06, "text": "این فشار روانی روی سرآشپزها چقدره؟"}, {"i": 87, "t0": 245.76, "t1": 246.82, "text": "شدیداً."}, {"i": 88, "t0": 246.26, "t1": 248.66, "text": "ستاره‌ها دائمی نیستن."}, {"i": 89, "t0": 248.12, "t1": 251.6, "text": "اگه استاندارد حفظ نشه، ستاره گرفته میشه."}, {"i": 90, "t0": 251.36, "t1": 254.46, "text": "یه رستوران با ستاره یک‌شبه معروف میشه."}, {"i": 91, "t0": 254.22, "t1": 257.28, "text": "ولی از دست دادنش می‌تونه ورشکستش کنه."}, {"i": 92, "t0": 257.86, "t1": 259.18, "text": "یه نکته مهم هم هست."}, {"i": 93, "t0": 259.36, "t1": 261.2, "text": "ستاره همیشه به رستوران داده میشه."}, {"i": 94, "t0": 260.88, "t1": 262.64, "text": "نه به شخص سرآشپز."}, {"i": 95, "t0": 263.02, "t1": 266.14, "text": "آیا هنوز همون شرکت لاستیک‌ساز صاحبشه؟"}, {"i": 96, "t0": 266.06, "t1": 268.24, "text": "آره دقیقاً همون شرکته."}, {"i": 97, "t0": 267.72, "t1": 272.58, "text": "سازمان میشلین یه دپارتمان مستقل داخل غول لاستیک‌سازیه."}, {"i": 98, "t0": 272.32, "t1": 276.84, "text": "یکی از موفق‌ترین پروژه‌های بازاریابی تاریخ تجارته."}, {"i": 99, "t0": 277.5, "t1": 280.96, "text": "اون کتابچه قرمز بعد از صد سال هنوز چاپ میشه."}, {"i": 100, "t0": 280.9, "t1": 282.98, "text": "الان اپ و وب‌سایت هم دارن."}, {"i": 101, "t0": 282.86, "t1": 284.94, "text": "ولی نسخه چاپی هنوز گنجینه‌ست."}, {"i": 102, "t0": 285.66, "t1": 288.42, "text": "سرآشپزها با افتخار تو رستوران‌هاشون نشونش میدن."}, {"i": 103, "t0": 289.1, "t1": 293.22, "text": "پس دفعه بعد که اسم ستاره میشلین رو شنیدی، یادت باشه."}, {"i": 104, "t0": 293.72, "t1": 298.44, "text": "کل این امپراتوری لوکس دنیای غذا، فقط برای یه چیز خلق شد."}, {"i": 105, "t0": 298.22, "t1": 302.36, "text": "یه شرکت فرانسوی می‌خواست مردم رو راضی کنه."}, {"i": 106, "t0": 301.96, "t1": 305.74, "text": "تا لاستیک ماشینشون رو بیشتر تو جاده‌ها بسابن."}, {"i": 107, "t0": 306.22, "t1": 311.64, "text": "اگه از این داستان‌های عجیب و غریب خوشت اومد، حتماً پادکست ذره‌بین رو دنبال کن."}, {"i": 108, "t0": 311.4, "t1": 314.68, "text": "تو هر قسمت یه ذره‌بین تازه برات باز می‌کنیم."}], "words": [{"w": "تصور", "t0": 0.04, "t1": 0.64, "s": 0}, {"w": "کن", "t0": 0.64, "t1": 0.92, "s": 0}, {"w": "رفتی", "t0": 0.92, "t1": 1.24, "s": 0}, {"w": "یکی", "t0": 1.24, "t1": 1.52, "s": 0}, {"w": "از", "t0": 1.52, "t1": 1.62, "s": 0}, {"w": "لوکس‌ترین", "t0": 1.62, "t1": 2.52, "s": 0}, {"w": "رستوران‌های", "t0": 2.52, "t1": 3.2, "s": 0}, {"w": "دنیا.", "t0": 3.2, "t1": 4.2, "s": 0}, {"w": "بشقابت", "t0": 4.2, "t1": 4.82, "s": 1}, {"w": "پر", "t0": 4.82, "t1": 5.24, "s": 1}, {"w": "از", "t0": 5.24, "t1": 5.4, "s": 1}, {"w": "شاهکاره.", "t0": 5.4, "t1": 6.68, "s": 1}, {"w": "ولی", "t0": 6.68, "t1": 6.84, "s": 2}, {"w": "یه", "t0": 6.84, "t1": 6.94, "s": 2}, {"w": "سوال", "t0": 6.94, "t1": 7.16, "s": 2}, {"w": "عجیب", "t0": 7.16, "t1": 7.46, "s": 2}, {"w": "دارم.", "t0": 7.46, "t1": 8.22, "s": 2}, {"w": "قاضی", "t0": 8.22, "t1": 8.7, "s": 3}, {"w": "اصلی", "t0": 8.7, "t1": 9.28, "s": 3}, {"w": "این", "t0": 9.28, "t1": 9.52, "s": 3}, {"w": "غذا",