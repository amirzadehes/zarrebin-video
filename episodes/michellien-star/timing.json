{"sentences": [{"i": 0, "t0": 0, "t1": 6.26, "text": "تا حالا فکر کردی چرا توی رستوران‌های لوکس، ستاره‌ها از یه شرکت لاستیک میاد؟"}, {"i": 1, "t0": 7.06, "t1": 12.58, "text": "این داستان از سال ۱۹۰۰ شروع می‌شه، وقتی دو برادر میشلین یه کارخونه تایر داشتن."}, {"i": 2, "t0": 13.24, "t1": 16.74, "text": "اونها می‌خواستن مردم بیشتر رانندگی کنن تا لاستیک‌هایشون بفروشند."}, {"i": 3, "t0": 17.2, "t1": 24.0, "text": "پس یک کتابچه قرمز رنگ درست کردن؛ توش نقشه جاده‌ها، لیست پمپ بنزین و هتل‌ها بود."}, {"i": 4, "t0": 24.16, "t1": 29.22, "text": "هدفشون ساده بود: مردم رو به سفر ببرن، لاستیک‌هاشون زودتر ساییده می‌شه."}, {"i": 5, "t0": 29.84, "t1": 35.68, "text": "از سال ۱۹۲۰ کتابچه پولی شد، چون وقتی پول می‌گیریم، جدی می‌گیریم."}, {"i": 6, "t0": 35.22, "t1": 39.98, "text": "تو همون دهه ۲۰، بخش رستوران‌ها توی کتابچه حسابی محبوب شد."}, {"i": 7, "t0": 40.64, "t1": 44.64, "text": "برادرها تصمیم گرفتند تیمی از بازرس‌های مخفی استخدام کنن."}, {"i": 8, "t0": 45.08, "t1": 54.34, "text": "سال ۱۹۲۶ سیستم ستاره‌دار میشلین متولد شد؛ اول یک ستاره، بعد از ۱۹۳۱ سه سطح."}, {"i": 9, "t0": 54.22, "t1": 58.5, "text": "یک ستاره یعنی «غذای باکیفیت، ارزش توقف تو مسیر»."}, {"i": 10, "t0": 59.14, "t1": 63.8, "text": "دو ستاره یعنی «آشپزی عالی، ارزش انحراف از جاده اصلی»."}, {"i": 11, "t0": 64.42, "t1": 70.7, "text": "سه ستاره یعنی «آشپزی استثنایی، سفر مخصوص برای تست غذا»."}, {"i": 12, "t0": 70.58, "t1": 73.82, "text": "بازرس‌ها هیچ‌وقت پول می‌گیرن یا فرم پر نمی‌کنن."}, {"i": 13, "t0": 74.26, "t1": 77.98, "text": "اونا توی شبکه‌های اجتماعی، وبلاگ‌ها و نظرات مردم می‌گردن."}, {"i": 14, "t0": 77.4, "t1": 82.96, "text": "اگر رستوران سر و صدا بکنه یا مردم زیاد تعریف کنن، بازرس مخفی میره."}, {"i": 15, "t0": 83.42, "t1": 94.306, "text": "پنج فاکتور مهمشون: کیفیت مواد، تسلط بر طعم، شخصیت سرآشپز، ارزش پول، ثبات کیفیت."}, {"i": 16, "t0": 94.186, "t1": 100.39, "text": "به همین دلیل حتی یه دکه خیابونی تو بانکوک می‌تونه یک ستاره بگیره."}, {"i": 17, "t0": 101.17, "t1": 107.29, "text": "مثلاً «جِی فای» توی یک چهارپایه پلاستیکی، غذاش کلاس جهانیه."}, {"i": 18, "t0": 108.07, "t1": 110.19, "text": "قیمت‌ها هم بسته به ستاره فرق می‌کنه."}, {"i": 19, "t0": 110.89, "t1": 114.15, "text": "یک شام معمولی تو آمریکا حدود ۲۰ دلاره."}, {"i": 20, "t0": 114.79, "t1": 119.25, "text": "یک رستوران یک ستاره میشلین می‌طلبه حدود ۱۶۵ دلار."}, {"i": 21, "t0": 120.03, "t1": 127.55, "text": "دو ستاره می‌رسه به ۲۵۶ دلار، و سه ستاره به ۳۵۶ دلار یا حتی بیشتر."}, {"i": 22, "t0": 128.03, "t1": 133.61, "text": "اما استثناها هم هست؛ بعضی رستوران‌های یک ستاره فقط ۲ دلار می‌گیرن."}, {"i": 23, "t0": 134.25, "t1": 139.29, "text": "ستاره‌ها دائمی نیستن؛ اگر کیفیت حفظ نشه، ستاره گرفته می‌شه."}, {"i": 24, "t0": 140.09, "t1": 144.37, "text": "و مهم‌تر اینه که ستاره به رستوران داده می‌شه، نه به سرآشپز."}, {"i": 25, "t0": 145.37, "t1": 150.87, "text": "امروز هم شرکت میشلین، همان شرکت لاستیک‌ساز فرانسوی، این سیستم رو اداره می‌کنه."}, {"i": 26, "t0": 150.89, "t1": 155.51, "text": "کتابچه قرمز هنوز چاپ می‌شه و نسخه دیجیتالی هم داره."}, {"i": 27, "t0": 156.19, "t1": 168.77, "text": "پس دفعه‌ای که اسم یه رستوران میشلین‌دار می‌شنوی، یادت باشه: پشت این ستاره‌ها یک شرکت تایر، یک کتابچه قرمز و یک تیم مخفی از «کارآگاه‌های غذا» هستن!"}, {"i": 28, "t0": 169.51, "t1": 173.73, "text": "اگر دوست داری داستان‌های دیگه‌مون رو هم بشنوی، حتماً «ذره‌بین» رو دنبال کن!"}], "words": [{"w": "تا", "t0": 0.0, "t1": 0.1, "s": 0}, {"w": "حالا", "t0": 0.1, "t1": 0.6, "s": 0}, {"w": "فکر", "t0": 0.6, "t1": 0.86, "s": 0}, {"w": "کردی", "t0": 0.86, "t1": 1.16, "s": 0}, {"w": "چرا", "t0": 1.16, "t1": 1.4, "s": 0}, {"w": "توی", "t0": 1.4, "t1": 1.6, "s": 0}, {"w": "رستوران‌های", "t0": 1.6, "t1": 2.4, "s": 0}, {"w": "لوکس،", "t0": 2.4, "t1": 2.98, "s": 0}, {"w": "ستاره‌ها", "t0": 2.98, "t1": 3.92, "s": 0}, {"w": "از", "t0": 3.98, "t1": 4.18, "s": 0}, {"w": "یه", "t0": 4.18, "t1": 4.34, "s": 0}, {"w": "شرکت", "t0": 4.34, "t1": 4.78, "s": 0}, {"w": "لاستیک", "t0": 4.78, "t1": 5.32, "s": 0}, {"w": "میاد؟", "t0": 5.32, "t1": 6.26, "s": 0}, {"w": "این", "t0": 7.18, "