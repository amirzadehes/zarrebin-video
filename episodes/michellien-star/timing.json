{"sentences": [{"i": 0, "t0": 0, "t1": 4.42, "text": "تو تا حالا فکر کردی چرا یه رستوران لوکس می‌تونه ستاره میشلین بگیره؟"}, {"i": 1, "t0": 5.28, "t1": 8.3, "text": "پاسخش توی یه کتابچه قرمز و یه شرکت لاستیک‌سازیه!"}, {"i": 2, "t0": 10.28, "t1": 12.42, "text": "می‌دونی داستان از کجا شروع شد؟"}, {"i": 3, "t0": 13.36, "t1": 18.02, "text": "دو برادر میشلین تو سال ۱۹۰۰ تو فرانسه یه کارخونه لاستیک داشتن."}, {"i": 4, "t0": 19.16, "t1": 24.28, "text": "ماشین‌ها تو اون زمان کمتر از سه‌هزار تا بود و مردم اصلاً رانندگی نمی‌کردن."}, {"i": 5, "t0": 25.34, "t1": 30.66, "text": "برادرها می‌خواستن لاستیک‌های بیشتری بفروشونن، پس راه‌حلی هوشمندانه پیدا کردند."}, {"i": 6, "t0": 32.08, "t1": 34.64, "text": "اونا یه کتابچه قرمز رنگ درست کردن."}, {"i": 7, "t0": 35.7, "t1": 42.64, "text": "توش نقشه جاده‌ها، لیست پمپ بنزین، راهنمای پنچرگیری و حتی هتل‌ها و غذاخوری‌های بین راه بود."}, {"i": 8, "t0": 43.78, "t1": 51.02, "text": "هدفش این بود که مردم دلیل داشته باشن سفر کنن، لاستیک‌هاشون زودتر ساییده بشه و لازمه خرید لاستیک جدید می‌شه."}, {"i": 9, "t0": 52.1, "t1": 58.88, "text": "این کتابچه تو حدود بیست سال رایگان تو بازار بود، بعدش پولی شد چون مردم فقط چیزهای پولی رو جدی می‌گیرن."}, {"i": 10, "t0": 60.24, "t1": 64.9, "text": "در دههٔ ۲۲۰، بخش غذاهای کتابچه حسابی پرطرفدار شد."}, {"i": 11, "t0": 65.98, "t1": 71.76, "text": "برادرها تصمیم گرفتن تیمی از بازرس‌های مخفی استخدام کنن تا رستوران‌ها رو ارزیابی کنن."}, {"i": 12, "t0": 72.86, "t1": 81.72, "text": "سال ۱۹۲۶ ستاره‌دادن شروع شد؛ اول یک ستاره، بعد از ۱۹۳۱ سه سطحی شد."}, {"i": 13, "t0": 82.34, "t1": 85.58, "text": "جالب اینه که معنی ستاره‌ها هنوز به سفر ربط داره:"}, {"i": 14, "t0": 87.0, "t1": 90.58, "text": "یک ستاره = غذای باکیفیت، ارزش توقف تو مسیر."}, {"i": 15, "t0": 91.6, "t1": 95.42, "text": "دو ستاره = آشپزی عالی، ارزش انحراف از جاده اصلی."}, {"i": 16, "t0": 96.5, "t1": 102.506, "text": "سه ستاره = آشپزی استثنایی، ارزش سفر فقط برای تست غذا."}, {"i": 17, "t0": 102.386, "t1": 104.826, "text": "بازرس‌ها هیچ‌وقت دعوت یا پولی می‌گیرن."}, {"i": 18, "t0": 105.946, "t1": 110.366, "text": "اونا از شبکه‌های اجتماعی، وبلاگ‌ها و نظرات مردم خبر می‌گیرن."}, {"i": 19, "t0": 111.506, "t1": 121.166, "text": "وقتی می‌رن، فقط پنج فاکتور رو می‌سنجن: مواد اولیه، تسلط روی طعم، شخصیت سرآشپز، ارزش نسبت به قیمت و ثبات کیفیت."}, {"i": 20, "t0": 122.066, "t1": 127.566, "text": "به همین خاطر حتی یه دکه خیابونی تو بانکوک به اسم «جی فای» یک ستاره میشلین داره."}, {"i": 21, "t0": 128.186, "t1": 134.846, "text": "تو می‌نشینی روی چهارپایه پلاستیکی، آشپزش پیرزن با عینک ایمنی، اما غذاش کلاس جهانیه."}, {"i": 22, "t0": 136.266, "t1": 137.866, "text": "قیمت‌ها هم فرق می‌کنن."}, {"i": 23, "t0": 138.966, "t1": 141.626, "text": "تو آمریکا یه شام معمولی حدود ۲۰ دلاره."}, {"i": 24, "t0": 142.666, "t1": 153.666, "text": "یک رستوران یک ستاره میشلین می‌طلبه حدود ۱۶۵ دلار، دو ستاره حدود ۲۵۶ دلار و سه ستاره می‌رسه به ۳۵۶ دلار برای هر نفر."}, {"i": 25, "t0": 154.726, "t1": 161.046, "text": "البته استثناهای عجیب هم هست؛ مثلاً تو هنگ‌کنگ یه ستاره میشلین می‌تونه فقط ۲ دلار هزینه داشته باشه."}, {"i": 26, "t0": 162.486, "t1": 166.746, "text": "ستاره‌ها دائم نیستن؛ اگر کیفیت حفظ نشه، ستاره گرفته می‌شه."}, {"i": 27, "t0": 167.866, "t1": 171.686, "text": "و مهم‌تر از همه، ستاره به رستوران داده می‌شه، نه به سرآشپز."}, {"i": 28, "t0": 173.406, "t1": 181.866, "text": "پس دفعه بعد که اسم یه رستوران میشلین‌دار به گوش‌ات می‌رسه، یادت باشه پشت این همه لوکس‌گری یه شرکت لاستیک‌سازی فرانسوی داره که"}, {"i": 29, "t0": 183.086, "t1": 185.686, "text": "می‌خواد مردم بیشتر تو جاده‌ها رانندگی کنن."}, {"i": 30, "t0": 187.086, "t1": 192.306, "text": "اگه خوشت اومد این داستان، حتماً توی «ذره‌بین» بمان و ماجراهای دیگه رو هم دنبال کن!"}], "words": [{"w": "تو", "t0": 0.0, "t1": 0.26, "s": 0}, {"w": "تا", "t0": 0.26, "t1": 0.48, "s": 0}, {"w": "حالا", "t0": 0.48, "t1": 0.68, "s": 0}, {"w": "فکر", "t0": 0.68, "t1": 0.84, "s": 0}, {"w": "کردی", "t0": 0.84, "t1": 1.14, "s": 0}, {"w": "چرا", "t0": 1.14, "t1": 1.4, "s": 0}, {"w": "یه", "t0": 1.4, "t1": 1.54, "s": 0}, {"w": "رستو