{"sentences": [{"i": 0, "t0": 0, "t1": 4.66, "text": "معتبرترین جایزهٔ آشپزی دنیا رو یه کارخونهٔ لاستیک‌سازی میده"}, {"i": 1, "t0": 5.36, "t1": 6.62, "text": "آره میشلن"}, {"i": 2, "t0": 7.02, "t1": 10.66, "text": "ولی یه شرکت لاستیک از کجا میفهمه کدوم غذا بهترینه"}, {"i": 3, "t0": 11.46, "t1": 13.18, "text": "برگردیم به سال ۱۹۰۰"}, {"i": 4, "t0": 14.24, "t1": 17.52, "text": "اون موقع کل فرانسه کمتر از سه هزار تا ماشین داشت"}, {"i": 5, "t0": 17.98, "t1": 21.1, "text": "برادرهای میشلن لاستیک میساختن ولی یه مشکل داشتن"}, {"i": 6, "t0": 21.42, "t1": 23.88, "text": "فروش لاستیکشون کم بود چون"}, {"i": 7, "t0": 23.76, "t1": 25.92, "text": "مردم با ماشینشون زیاد جایی نمی‌رفتند"}, {"i": 8, "t0": 26.54, "t1": 30.12, "text": "پس یه فکر خفن کردن که مردمو بکشونن تو جاده‌ها"}, {"i": 9, "t0": 30.68, "t1": 33.46, "text": "یه کتاب راهنمایی مجانی دادن به راننده‌ها"}, {"i": 10, "t0": 33.72, "t1": 37.66, "text": "نقشه، پمپ بنزین، تعمیرگاه، هتل و رستوران"}, {"i": 11, "t0": 38.1, "t1": 40.08, "text": "هدف ساده بود مردم"}, {"i": 12, "t0": 39.96, "t1": 43.58, "text": "بیشتر سفر کنن، لاستیکشون زودتر تموم بشه و"}, {"i": 13, "t0": 43.46, "t1": 44.64, "text": "لاستیک نو بخرن"}, {"i": 14, "t0": 45.88, "t1": 50.7, "text": "سال ۱۹۲۶ میشلن به بهترین رستوران‌های کتاب ستاره داد"}, {"i": 15, "t0": 51.34, "t1": 53.1, "text": "بله معنی ستاره‌ها رو ببین"}, {"i": 16, "t0": 53.8, "t1": 57.28, "text": "یک ستاره یعنی یه رستوران خیلی خوب تو دسته خودش"}, {"i": 17, "t0": 57.8, "t1": 61.82, "text": "دو ستاره یعنی واسه این رستوران مسیرتو کُچ کنی"}, {"i": 18, "t0": 62.5, "t1": 71.84, "text": "سه ستاره یعنی فقط به خاطر همین رستوران سفر کنی، دیدی؟ ستاره‌ها با کیلومتر اندازه‌گیری می‌شن؛ هر"}, {"i": 19, "t0": 71.72, "t1": 74.54, "text": "ستاره بیشتر یعنی رانندگی بیشتر یعنی"}, {"i": 20, "t0": 74.42, "t1": 75.64, "text": "همون فروش لاستیک"}, {"i": 21, "t0": 76.4, "t1": 79.12, "text": "ولی هیچ رستورانی نمی‌تونه این ستاره رو بخره"}, {"i": 22, "t0": 79.66, "t1": 82.56, "text": "بازرس‌های میشلن شش ناشناس هستند"}, {"i": 23, "t0": 82.96, "t1": 85.0, "text": "با اسم جعلی میز رزرو می‌کنن"}, {"i": 24, "t0": 84.9, "t1": 89.52, "text": "مثل یه مشتری معمولی غذا می‌خورن و صورت‌حسابو خودشون می‌دن"}, {"i": 25, "t0": 89.88, "t1": 93.58, "text": "بازرس هیچ‌وقت نمی‌دونه کدوم مشتری بازرسه، پس"}, {"i": 26, "t0": 93.46, "t1": 97.76, "text": "هر بشقابی که از آشپزخونه بیرون میره باید عالی باشه"}, {"i": 27, "t0": 98.2, "t1": 101.14, "text": "به‌سبب همین این ستاره‌ها انقدر کمیابن"}, {"i": 28, "t0": 101.64, "t1": 106.2, "text": "امروز تو کل دنیا فقط حدود ۱۵۰ رستوران سه ستاره دارن"}, {"i": 29, "t0": 106.58, "t1": 110.96, "text": "پس دفعه بعد که اسم یه رستوران ستاره‌دار رو شنیدی یادت باشه"}, {"i": 30, "t0": 110.9, "t1": 117.54, "text": "معتبرترین جایزهٔ آشپزی دنیا از یه ترفند فروش لاستیک شروع شد"}, {"i": 31, "t0": 118.06, "t1": 121.04, "text": "اگه بیشتر می‌خوای، ویدیوی کاملش توی یوتیوب هست"}, {"i": 32, "t0": 121.52, "t1": 123.44, "text": "ذره‌بین دست توست بگی"}, {"i": 33, "t0": 123.32, "t1": 124.7, "text": "بعدی رو کجا بذاریم"}], "words": [{"w": "معتبرترین", "t0": 0.04, "t1": 0.72, "s": 0}, {"w": "جایزهٔ", "t0": 1.0, "t1": 1.46, "s": 0}, {"w": "آشپزی", "t0": 1.54, "t1": 2.08, "s": 0}, {"w": "دنیا", "t0": 2.08, "t1": 2.56, "s": 0}, {"w": "رو", "t0": 2.56, "t1": 2.72, "s": 0}, {"w": "یه", "t0": 2.72, "t1": 3.0, "s": 0}, {"w": "کارخونهٔ", "t0": 3.0, "t1": 3.56, "s": 0}, {"w": "لاستیک‌سازی", "t0": 3.7, "t1": 4.02, "s": 0}, {"w": "میده", "t0": 4.38, "t1": 4.66, "s": 0}, {"w": "آره", "t0": 5.48, "t1": 5.8, "s": 1}, {"w": "میشلن", "t0": 6.16, "t1": 6.62, "s": 1}, {"w": "ولی", "t0": 7.14, "t1": 7.38, "s": 2}, {"w": "یه", "t0": 7.38, "t1": 7.62, "s": 2}, {"w": "شرکت", "t0": 7.62, "t1": 7.94, "s": 2}, {"w": "لاستیک", "t0": 7.94, "t1": 8.48, "s": 2}, {"w": "از", "t0": 8.48, "t1": 8.68, "s": 2}, {"w": "کجا", "t0": 8.68, "t1": 9.06, "s": 2}, {"w": "میفهمه", "t0": 9.06, "t1": 9.4, "s": 2}, {"w": "کدوم", "t0": 9.4, "t1": 9.74, "s": 2}, {"w": "غذا", "t0": 9.74, "t1": 10.02, "s": 2}, {"w": "بهترینه", "t0": 10.02, "t1": 10