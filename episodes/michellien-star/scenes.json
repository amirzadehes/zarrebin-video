y/eye-open__1.webp", "en": "right"}], "text": "*رستوران‌ها* محبوب شدند", "link": "vs"}, {"t0": 45.492, "t1": 53.008, "tpl": "statement", "theme": 2, "wipe": 0, "items": [], "text": "*بازرس‌های* مخفی ارزیابی می‌کنند", "link": "vs"}, {"t0": 53.008, "t1": 63.062, "tpl": "statement", "theme": 5, "wipe": 1, "items": [], "text": "*ستاره* میشلین ۱۹۲۶", "link": "vs"}, {"t0": 63.062, "t1": 73.846, "tpl": "statement", "theme": 0, "wipe": 2, "items": [], "text": "*یک، دو، سه* ستاره‌ها", "link": "vs"}, {"t0": 73.846, "t1": 80.636, "tpl": "statement", "theme": 3, "wipe": 0, "items": [], "text": "*بازرس‌ها* بدون پول‌گیری", "link": "vs"}, {"t0": 80.636, "t1": 86.136, "tpl": "statement", "theme": 6, "wipe": 1, "items": [], "text": "*بازرس‌ها* بدون پول‌گیری", "link": "vs"}, {"t0": 86.136, "t1": 93.844, "tpl": "statement", "theme": 1, "wipe": 2, "items": [], "text": "آن‌ها به‌صورت مخفی، شبکه‌های اجتماعی، نقدهای روزنامه", "link": "vs"}, {"t0": 93.844, "t1": 105.506, "tpl": "statement", "theme": 4, "wipe": 0, "items": [], "text": "هنگام بازدید، پنج فاکتور بررسی می‌شود: کیفیت", "link": "vs"}, {"t0": 105.506, "t1": 118.924, "tpl": "statement", "theme": 7, "wipe": 1, "items": [], "text": "به همین دلیل حتی یک دکه خیابانی", "link": "vs"}, {"t0": 118.924, "t1": 132.972, "tpl": "statement", "theme": 2, "wipe": 2, "items": [], "text": "قیمت‌ها هم متفاوت‌اند. در آمریکا یک شام", "link": "vs"}, {"t0": 132.972, "t1": 141.592, "tpl": "statement", "theme": 5, "wipe": 0, "items": [], "text": "دو ستاره میانگین ۲۵۶ دلار و سه", "link": "vs"}, {"t0": 141.592, "t1": 148.31, "tpl": "statement", "theme": 0, "wipe": 1, "items": [], "text": "برخی رستوران‌های دوستاره حتی برای یک شام", "link": "vs"}, {"t0": 148.31, "t1": 154.578, "tpl": "statement", "theme": 3, "wipe": 2, "items": [], "text": "ستاره‌ها دائمی نیستند؛ اگر استانداردها حفظ نشود،", "link": "vs"}, {"t0": 154.578, "t1": 169.79, "tpl": "statement", "theme": 6, "wipe": 0, "items": [], "text": "مهم است به یاد داشته باشید که", "link": "vs"}, {"t0": 169.79, "t1": 179.0, "tpl": "statement", "theme": 1, "wipe": 1, "items": [], "text": "اگر از این داستان لذت بردید، حتماً", "link": "vs"}]}