t1": 55.92, "tpl": "statement", "theme": 0, "wipe": 2, "items": [], "text": "رستوران‌ها *پرطرفدار* شد", "link": "vs"}, {"t0": 55.92, "t1": 63.32, "tpl": "hero", "theme": 3, "wipe": 0, "items": [{"t": 56.72, "src": "library/money-bag__3.webp", "en": "pop"}], "text": "استخدام *بازرس‌های* مخفی", "link": "vs"}, {"t0": 63.32, "t1": 75.72, "tpl": "statement", "theme": 6, "wipe": 1, "items": [], "text": "*ستاره* میشلین از ۱۹۲۶", "link": "vs"}, {"t0": 75.72, "t1": 85.16, "tpl": "statement", "theme": 1, "wipe": 2, "items": [], "text": "جالب اینه که معنی ستاره‌ها هنوز به", "link": "vs"}, {"t0": 85.16, "t1": 94.52, "tpl": "statement", "theme": 4, "wipe": 0, "items": [], "text": "دو ستاره «آشپزی عالی که مسیرتو عوض", "link": "vs"}, {"t0": 94.52, "t1": 107.603, "tpl": "statement", "theme": 7, "wipe": 1, "items": [], "text": "بازرس‌ها هیچ‌وقت پول می‌گیرن یا درخواست رستوران‌ها", "link": "vs"}, {"t0": 107.603, "t1": 118.903, "tpl": "statement", "theme": 2, "wipe": 2, "items": [], "text": "وقتی می‌رن فقط پنج فاکتور رو می‌سنجه:", "link": "vs"}, {"t0": 118.903, "t1": 132.983, "tpl": "statement", "theme": 5, "wipe": 0, "items": [], "text": "به همین دلیل حتی یک دکه خیابونی", "link": "vs"}, {"t0": 132.983, "t1": 152.123, "tpl": "statement", "theme": 0, "wipe": 1, "items": [], "text": "قیمت‌ها هم فرق می‌کنه. تو آمریکا یک", "link": "vs"}, {"t0": 152.123, "t1": 160.043, "tpl": "statement", "theme": 3, "wipe": 2, "items": [], "text": "اما استثنا هم هست؛ مثلاً «تیم هو", "link": "vs"}, {"t0": 160.043, "t1": 167.383, "tpl": "statement", "theme": 6, "wipe": 0, "items": [], "text": "ستاره‌ها ثابت نیستن؛ اگر کیفیت حفظ نشه،", "link": "vs"}, {"t0": 167.383, "t1": 180.443, "tpl": "statement", "theme": 1, "wipe": 1, "items": [], "text": "مهم اینه که ستاره به رستوران داده", "link": "vs"}, {"t0": 180.443, "t1": 190.303, "tpl": "statement", "theme": 4, "wipe": 2, "items": [], "text": "حالا که این داستانو می‌دونی، وقتی اسم", "link": "vs"}, {"t0": 190.303, "t1": 197.65, "tpl": "statement", "theme": 7, "wipe": 0, "items": [], "text": "اگر دوست داری داستانای دیگه‌مون رو هم", "link": "vs"}]}