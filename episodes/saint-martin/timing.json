{"sentences": [{"i": 0, "t0": 0, "t1": 10.72, "text": "امروز میخوام داستان سنت مارتین رو بگم. همون شبیه که بچه ها تو آلمان فانوس به دست پشت یه سرباز رومی را میوفتن و شام اون شب کباب غازه. ولی این سرباز کی و غاز اینجا چی"}, {"i": 1, "t0": 10.6, "t1": 11.36, "text": "کار است؟"}, {"i": 2, "t0": 11.8, "t1": 22.2, "text": "حدود 1700 سال پیش مارتین یه سرباز 18 ساله رومی بود. میگن یه شب سرد تو فرانسه یه گدای تقریبا لخ دید که از سرما میلرزید. پولی نداشت که"}, {"i": 3, "t0": 22.08, "t1": 23.04, "text": "بهش بده."}, {"i": 4, "t0": 22.44, "t1": 27.96, "text": "پس شنل ارتشیشو با شمشیر از وسط نصف کرد و نصفشو داد بهش"}, {"i": 5, "t0": 28.66, "t1": 32.8, "text": "امروز تو رژه یه نفر لباس همون سربازو میپوشه و سبار عصب جلو میره"}, {"i": 6, "t0": 33.18, "t1": 37.74, "text": "وسط راه شنلشو نصف میکنه و به کسی میده که نقش گدارو داره بچه"}, {"i": 7, "t0": 37.62, "t1": 39.02, "text": "هم فانوس به دست دنبالش میرن"}, {"i": 8, "t0": 39.72, "t1": 42.4, "text": "حالا چرا یازده نوامر؟ معمولا"}, {"i": 9, "t0": 42.28, "t1": 45.24, "text": "روزی که به اسمی قدیسه همون روز مرگشه ولی"}, {"i": 10, "t0": 45.12, "t1": 46.8, "text": "مارتین هشت نوامر مرت"}, {"i": 11, "t0": 46.72, "t1": 49.34, "text": "اما 11 نوان خاک سپاریش کردن"}, {"i": 12, "t0": 50.14, "t1": 56.48, "text": "روز سنت مارتین تصادفاً با آخر سال کشاورزی و شروع روزه چهل روزه یکی شده"}, {"i": 13, "t0": 56.86, "t1": 60.18, "text": "اون زمان 11 نوان روز پرداخت اجاره و مالیات هم بوده"}, {"i": 14, "t0": 60.48, "t1": 63.38, "text": "و خیلی ها با قاز مالیاتشونو میدن و"}, {"i": 15, "t0": 63.26, "t1": 67.14, "text": "چون برای روزه خوردن گوشت ممنون میشده شبش همه میریختن سر قاز"}, {"i": 16, "t0": 67.82, "t1": 71.32, "text": "پس رجه سنت مارتین یادگاری سرباز مهربونه ولی"}, {"i": 17, "t0": 71.2, "t1": 73.84, "text": "کباب قاز برای یه مالیات و روزه بوده"}, {"i": 18, "t0": 73.76, "t1": 77.3, "text": "کامل ترشو تو یوتیوبمون گذاشتیم اگه میخوایی بیشتر در موردش بدونی"}, {"i": 19, "t0": 77.6, "t1": 78.98, "text": "زهر بین دست شماست"}, {"i": 20, "t0": 79.2, "t1": 80.72, "text": "بگین بعدی رو کاجا بذاریم"}], "words": [{"w": "امروز", "t0": 0.0, "t1": 0.46, "s": 0}, {"w": "میخوام", "t0": 0.46, "t1": 0.78, "s": 0}, {"w": "داستان", "t0": 0.78, "t1": 1.24, "s": 0}, {"w": "سنت", "t0": 1.24, "t1": 1.62, "s": 0}, {"w": "مارتین", "t0": 1.62, "t1": 2.0, "s": 0}, {"w": "رو", "t0": 2.0, "t1": 2.02, "s": 0}, {"w": "بگم.", "t0": 2.02, "t1": 2.64, "s": 0}, {"w": "همون", "t0": 2.64, "t1": 2.86, "s": 0}, {"w": "شبیه", "t0": 2.86, "t1": 3.02, "s": 0}, {"w": "که", "t0": 3.02, "t1": 3.14, "s": 0}, {"w": "بچه", "t0": 3.14, "t1": 3.4, "s": 0}, {"w": "ها", "t0": 3.4, "t1": 3.44, "s": 0}, {"w": "تو", "t0": 3.44, "t1": 3.56, "s": 0}, {"w": "آلمان", "t0": 3.56, "t1": 3.94, "s": 0}, {"w": "فانوس", "t0": 3.94, "t1": 4.44, "s": 0}, {"w": "به", "t0": 4.44, "t1": 4.6, "s": 0}, {"w": "دست", "t0": 4.6, "t1": 4.76, "s": 0}, {"w": "پشت", "t0": 4.76, "t1": 5.08, "s": 0}, {"w": "یه", "t0": 5.08, "t1": 5.24, "s": 0}, {"w": "سرباز", "t0": 5.24, "t1": 5.62, "s": 0}, {"w": "رومی", "t0": 5.62, "t1": 6.0, "s": 0}, {"w": "را", "t0": 6.0, "t1": 6.14, "s": 0}, {"w": "میوفتن", "t0": 6.14, "t1": 6.52, "s": 0}, {"w": "و", "t0": 6.52, "t1": 6.6, "s": 0}, {"w": "شام", "t0": 6.6, "t1": 6.92, "s": 0}, {"w": "اون", "t0": 6.92, "t1": 7.08, "s": 0}, {"w": "شب", "t0": 7.08, "t1": 7.3, "s": 0}, {"w": "کباب", "t0": 7.3, "t1": 7.72, "s": 0}, {"w": "غازه.", "t0": 7.72, "t1": 8.76, "s": 0}, {"w": "ولی", "t0": 8.76, "t1": 8.98, "s": 0}, {"w": "این", "t0": 8.98, "t1": 9.1, "s": 0}, {"w": "سرباز", "t0": 9.1, "t1": 9.56, "s": 0}, {"w": "کی", "t0": 9.56, "t1": 9.76, "s": 0}, {"w": "و", "t0": 9.76, "t1": 9.94, "s": 0}, {"w": "غاز", "t0": 9.94, "t1": 10.38, "s": 0}, {"w": "اینجا", "t0": 10.38, "t1": 10.58, "s": 0}, {"w": "چی", "t0": 10.58, "t1": 10.72, "s": 0}, {"w": "کار", "t0": 10.72, "t1": 10.9, "s": 1}, {"w": "است؟", "t0": 10.9, "t1": 11.36, "s": 1}, {"w": "حدود", "t0": 11.92, "t1": 12.2, "s": 2}, {"w": "1700", "t0": 12.2, "t1": 13.0, "s": 2}, {"w": "سال", "t0": 13.0, "t1": 13.42, "s": 2}