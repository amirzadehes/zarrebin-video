{"sentences": [{"i": 0, "t0": 0, "t1": 6.32, "text": "چرا اگه فلفل بخوری احساس میکنی دهن داغ شده، این حس گرما از کجا میاد؟ بزار،"}, {"i": 1, "t0": 6.2, "t1": 8.14, "text": "یه چیز عجیب بگم."}, {"i": 2, "t0": 8.06, "t1": 10.96, "text": "توندی فلفل اصلا مزه نیست."}, {"i": 3, "t0": 10.84, "t1": 11.86, "text": "یه درده."}, {"i": 4, "t0": 12.5, "t1": 15.3, "text": "خب، این سوزش و درد از کجا میاد؟ توی"}, {"i": 5, "t0": 15.18, "t1": 19.8, "text": "دهن و پوست ما یه گیرنده مخصوص هست که کارش خبر دادن از گرمای زیاده."}, {"i": 6, "t0": 19.98, "t1": 24.0, "text": "وقتی چایی یا سوپی که از حدود 43 درجه داغتره بخوری،"}, {"i": 7, "t0": 23.96, "t1": 29.26, "text": "این گیرنده مثل یه آجیر به مغزت خبر میده که بسه این چیزی که داری میخوری خیلی داغه."}, {"i": 8, "t0": 29.46, "t1": 32.36, "text": "فلفل یه ماده داره به اسم کپسایسین."}, {"i": 9, "t0": 32.24, "t1": 37.24, "text": "شکلش دقیقا جوریه که به همون گیرنده یه آجیر گرمو میچسبه."}, {"i": 10, "t0": 37.08, "t1": 39.76, "text": "یعنی بدون هیچ گرمای واقعی آجیر روشن میشه."}, {"i": 11, "t0": 40.08, "t1": 45.54, "text": "مغزت فکر میکنه این چیزی که خوردی خیلی داغه ولی دمای دهنت همون دمای همیشگیه."}, {"i": 12, "t0": 45.04, "t1": 50.4, "text": "حالا چرا فلفل باید اصلا همچین مادهی تولید کنه؟ جوابش"}, {"i": 13, "t0": 50.28, "t1": 51.34, "text": "دفاع شخصیه"}, {"i": 14, "t0": 51.66, "t1": 53.3, "text": "بسه یه مثال بزنم تو"}, {"i": 15, "t0": 53.18, "t1": 56.4, "text": "بیاغونهای آریزونا فلفل وحشی هست پرنده"}, {"i": 16, "t0": 56.28, "t1": 58.02, "text": "ها میرن سراغشون میخورنش ولی"}, {"i": 17, "t0": 57.9, "t1": 60.7, "text": "موش ها اصلا سمتش نمیرن محقق"}, {"i": 18, "t0": 60.58, "t1": 67.16, "text": "ها دیدن پرنده ها دونه ی فلفل رو کاملا سالم دفت میکنن و این دونه جای دورتر میفته زمین رو جوونه میزنه"}, {"i": 19, "t0": 67.1, "t1": 73.31, "text": "ولی موشی که فلفل رو میخوره دونش رو می کنن و این دونه جای دورتر می افته زمین رو جوونه می زنه ولی موشی که فلفل رو می خوره دونهش رو خورد می کنه و این دونه دیگه جوونه نمی زنه راز"}, {"i": 20, "t0": 73.19, "t1": 75.15, "text": "همین جاست گیرنده"}, {"i": 21, "t0": 75.03, "t1": 78.53, "text": "پرنده ها به کپسایسین فلفل جواب نمی ده پس"}, {"i": 22, "t0": 78.41, "t1": 80.79, "text": "احساس تندی و داغی نمی کنن و"}, {"i": 23, "t0": 80.67, "t1": 84.25, "text": "می تونن فلفل رو راحت بخورن و دونهش رو برای تکثیر پخش کنن"}, {"i": 24, "t0": 84.71, "t1": 87.43, "text": "حالا این تندی رو چطور اندازه میگیرن؟ سال"}, {"i": 25, "t0": 87.31, "t1": 92.91, "text": "1912 یه داروساز امریکایی به اسم ویلبرسکوویل یه روش ساده ساخت یه"}, {"i": 26, "t0": 92.79, "t1": 97.03, "text": "قاشق چای خوری او ساره فلفل رو توی یه زرف میریخت و اونقدر آب اضافه میکرد تا"}, {"i": 27, "t0": 96.91, "t1": 100.79, "text": "چند نفر که میچشیدنش دیگه هیچ تندی حس نکنند هرچی"}, {"i": 28, "t0": 100.67, "t1": 104.31, "text": "آب بیشتر برای رقیق کردن لازم بود فلفل تندتر بود"}, {"i": 29, "t0": 105.25, "t1": 106.19, "text": "بذار با عدد بگم"}, {"i": 30, "t0": 106.45, "t1": 108.51, "text": "فلفل دلمهی صفره یعنی"}, {"i": 31, "t0": 108.39, "t1": 110.91, "text": "اصلا آب اضافه لازم نداره خالا"}, {"i": 32, "t0": 110.79, "t1": 113.67, "text": "پینو حدود پنج هزار واحد تنده یعنی"}, {"i": 33, "t0": 113.55, "t1": 115.11, "text": "اون یه قاشق و ساره رو باید"}, {"i": 34, "t0": 114.99, "t1": 117.55, "text": "تو حدود بیس و پنج لیتر آب حل کنی تا"}, {"i": 35, "t0": 117.43, "t1": 118.41, "text": "تندیش گم بشه"}, {"i": 36, "t0": 118.97, "t1": 124.01, "text": "فلفل تای حدود پنجاه تا سد هزار واحد تندی اینجا"}, {"i": 37, "t0": 123.89, "t1": 126.67, "text": "دیگه چند سد لیتر آب لازمه حابانه"}, {"i": 38, "t0": 126.55, "t1": 132.74, "text": "رو چند سد هزار واحد یعنی حدود یه منبع آب هزار لیتری لازم داری که تندیش از بین بره"}, {"i": 39, "t0": 133.22, "t1": 139.28, "text": "فلفل گوست حدود یک میلیون واحد یعنی حدود پنج هزار لیتر آب واسش میخواییم"}, {"i": 40, "t0": 139.8, "t1": 141.66, "text": "تندتنین فلفل های دنیا ویسه"}, {"i": 41, "t0": 141.54, "t1": 145.46, "text": "کارولیناری پر حدود دو میلیون واحد تندن یعنی"}, {"i": 42, "t0": 145.34, "t1": 150.22, "text": "همون یه قاشق اصاره رو باید حدود ده هزار لیتر آب حل کنی تا خونسابشه"}, {"i": 43, "t0": 150.92, "t1": 153.96, "text": "و کپ سایسینی که تو آزمایشگاه از فلفل جدا میکنن"}, {"i": 44, "t0": 153.9, "t1": 156.86, "text": "یعنی بودور سفید خالصش حدود"}, {"i": 45, "t0": 156.74, "t1": 160.66, "text": "16 میلیون واحد یعنی"}, {"i": 46, "t0": 160.54, "t1": 165.88, "text": "یه قاشوق ازشو باید تو حدود 80 هزار لیتر آب حل کنی یعنی"}, {"i": 47, "t0": 165.76, "t1": 167.1, "text": "اندازه یه استخر کچیک"}, {"i": 48, "t0": 167.8, "t1": 169.7, "text": "حالا فرض کنی یه فلفل خیلی تند خوردی"}, {"i": 49, "t0": 170.02, "t1": 174.34, "text": "اولین کاری که احساس تندی رو از بین ببری چیه؟ آب"}, {"i": 50, "t0": 174.22, "t1": 174.66, "text": "بخوری"}, {"i": 51, "t0": 175.38, "t1": 176.78, "text": "ولی این راهش نیست"}, {"i": 52, "t0": 177.16, "t1": 178.16, "text": "چرا؟ چون"}, {"i": 53, "t0": 178.04, "t1": 181.58, "text": "کاب ساییسین چرب دوسته و تو آب حل نمیشه آب"}, {"i": 54, "t0": 181.46, "t1": 183.52, "text": "فقط تو کل دهنت پخشش میکنه"}, {"i": 55, "t0": 183.44, "t1": 188.2, "text": "مثل زرف چربیه که فقط با آب تمیز نمیشه و مایه زرفشوی لازم داره"}, {"i": 56, "t0": 188.84, "t1": 191.6, "text": "شیر همون مایه زرفشویه پروتینی"}, {"i": 57, "t0": 191.48, "t1": 197.7, "text": "به اسم کازین داره که کابسایسینو از گیرنده ی زبون می کنه و می شوره ماستو بستنی هم همینطوره"}, {"i": 58, "t0": 198.64, "t1": 205.65, "text": "ولی یه سؤال دیگه بعضی ها فلفل رو مثل آجیلی می خورن و بعضی ها با یه ذرش عشقشون در می آد؟ سه"}, {"i": 59, "t0": 205.53, "t1": 206.23, "text": "تا دلیل داره."}, {"i": 60, "t0": 206.79, "t1": 208.51, "text": "اول آدت."}, {"i": 61, "t0": 208.49, "t1": 210.99, "text": "توی تحقیقیه ده هیوده روز هر"}, {"i": 62, "t0": 210.87, "t1": 212.89, "text": "روز مقدار کمی کابسایی سین."}, {"i": 63, "t0": 212.63, "t1": 214.47, "text": "همون چیزی که تندی ازش می آد و"}, {"i": 64, "t0": 214.35, "t1": 216.31, "text": "تو دهنشون نگه داشتن."}, {"i": 65, "t0": 216.11, "t1": 218.55, "text": "و سوزششون واقعا کمتر شد."}, {"i": 66, "t0": 218.43, "t1": 220.13, "text": "یعنی دهن آدت می کنه"}, {"i": 67, "t0": 220.45, "t1": 222.41, "text": "هنوز کسی دقیق نمی دونه چطور ولی"}, {"i": 68, "t0": 222.29, "t1": 225.01, "text": "کسایی که زیاد فلفل می خورن همیشه"}, {"i": 69, "t0": 224.89, "t1": 226.59, "text": "احساس سوزش کم تری دارن"}, {"i": 70, "t0": 227.27, "t1": 228.45, "text": "دوم جن"}, {"i": 71, "t0": 228.93, "t1": 231.87, "text": "گیرنده تندی تو همه ما یه جور نیست هم"}, {"i": 72, "t0": 231.75, "t1": 234.13, "text": "حساسیتش و هم تعدادش از"}, {"i": 73, "t0": 234.01, "t1": 235.67, "text": "آدمی با آدم دیگه فرق می کنه"}, {"i": 74, "t0": 235.95, "t1": 237.71, "text": "بقیهش محیطه مثلا"}, {"i": 75, "t0": 237.59, "t1": 240.71, "text": "این که از بچگی چقدر فلفل خورده سووم"}, {"i": 76, "t0": 240.59, "t1": 241.77, "text": "شخصیت"}, {"i": 77, "t0": 242.19, "t1": 244.53, "text": "آدم هایی که آشق ماجراجوی هستن"}, {"i": 78, "t0": 244.43, "t1": 246.53, "text": "معمولا تندی رو بیشتر دوست دارم"}, {"i": 79, "t0": 246.97, "t1": 248.73, "text": "یعنی فلفل دوستها این"}, {"i": 80, "t0": 248.61, "t1": 251.59, "text": "حس سوزش رو کمتر حس نمی کنن بلکه"}, {"i": 81, "t0": 251.47, "t1": 253.43, "text": "اون سوزش رو بیشتر دوست دارن"}, {"i": 82, "t0": 253.97, "t1": 255.57, "text": "جنبندی فلفل"}, {"i": 83, "t0": 255.45, "t1": 257.31, "text": "اصلا مزه نیست و"}, {"i": 84, "t0": 257.19, "t1": 258.95, "text": "واقعا نمی سوزونه فقط"}, {"i": 85, "t0": 258.83, "t1": 261.11, "text": "آجیر گرما تو دهن و پوست رو"}, {"i": 86, "t0": 260.99, "t1": 262.29, "text": "علکی روشن می کنه"}, {"i": 87, "t0": 262.83, "t1": 264.69, "text": "ذره بین دست شماست شما"}, {"i": 88, "t0": 264.57, "t1": 265.99, "text": "بگین بعدی رو کجا بذاریم"}], "words": [{"w": "چرا", "t0": 0.0, "t1": 0.52, "s": 0}, {"w": "اگه", "t0": 0.52, "t1": 0.8, "s": 0}, {"w": "فلفل", "t0": 0.8, "t1": 1.36, "s": 0}, {"w": "بخوری", "t0": 1.36, "t1": 1.72, "s": 0}, {"w": "احساس", "t0": 1.72, "t1": 2.28, "s": 0}, {"w": "میکنی", "t0": 2.28, "t1": 2.54, "s": 0}, {"w": "دهن", "t0": 